index 0000000000000000000000000000000000000000..f357f73ac2b2f1093ab930e96a866677abb630c9
--- /dev/null
+++ b/soh/src/code/ml_state.c
@@ -0,0 +1,301 @@
+#include "ml_state.h"
+#include "ml_entrance_map.h"
+#include "objects/gameplay_keep/gameplay_keep.h"
+#include "soh/ResourceManagerHelpers.h"
+#include "objects/object_link_child/object_link_child.h"
+#include "assets/ml_assets.h"
+#include <string.h>
+
+// MissingShip: ML's per-frame bookkeeping from its custom code.
+//
+// 0x80600E00 replaces Player_Update's call to Player_UpdateCommon (player +0x17E5C) and wraps it:
+// - It keys the current scene and room as sceneNum | (roomNum << 4) and counts frames since the key changed
+//   (0x80601680). At frame 17 it fills the whole Magic Hourglass history with Link's spot and jumps the count to its
+//   cap, 169, the value at which the Hourglass works.
+// - It keeps that history: 164 entries of Link's position and facing, newest first, shifted every frame.
+// - The Magic Hourglass (the boomerang slot: the throw sets gMlHourglassTrigger instead of spawning En_Boom): once
+//   the count is at its cap, it spawns the Song of Time wipe and rewinds Link through entries 69..161, 4 a frame, with
+//   Player_UpdateCommon skipped until it ends. Otherwise the trigger is dropped.
+// - Then the cucco keeper (0x80601000, see MlState_CuccoFrame).
+// 0x80602C80 (replacing the Math_Vec3f_Copy that applies a wall push-out in Actor_UpdateBgCheckInfo) skips the push
+// while the room counter is below 2, and, in Deep Woods, for the next gMlWallSkip calls after its looping corridor
+// teleports Link (set to 2 by the teleport, 0x80602188).
+
+u16 gMlRoomFrames = 0;   // 0x80609FF0
+s32 gMlWallSkip = 0;
+u16 gMlRewindStep = 0;   // 0x80609FF4: read by ML's tall HAKAdan elevator (En_Kakasi) and Boss_Va too
+u8 gMlHourglassTrigger = 0; // 0x80609FFF
+static u16 sMlRoomKey = 0;  // 0x80609FF2
+static Actor* sMlHourglassWipe = NULL; // 0x80609FEC
+
+#define ML_REWIND_LEN 164
+typedef struct {
+    Vec3f pos;
+    s16 yaw;
+} MlRewindEntry;
+static MlRewindEntry sMlRewind[ML_REWIND_LEN]; // 0x8060AC00
+
+// 0x80600AA8 / 0x80600AAA: ML's cucco carried through a void-out.
+static u16 sMlCuccoHealth = 0;
+static u16 sMlCuccoVoided = 0;
+
+static s32 MlCucco_Is(Actor* actor) {
+    // ML's copy keeps En_Niw's InitVars id; SoH's Ml_Cucco has its own slot's id.
+    return (actor->id == ACTOR_EN_NIW) || (actor->id == ACTOR_EN_POH);
+}
+
+static s32 MlCucco_InRoom(PlayState* play) {
+    for (Actor* actor = play->actorCtx.actorLists[ACTORCAT_PROP].head; actor != NULL; actor = actor->next) {
+        if (MlCucco_Is(actor)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// 0x80600480, before Play_TriggerVoidOut in the void-out action.
+void MlState_VoidOut(PlayState* play) {
+    gMlRoomFrames = 0;
+    if (MlCucco_InRoom(play)) {
+        sMlCuccoHealth = 0x77;
+        sMlCuccoVoided = 1;
+    }
+}
+
+// 0x80601000: one frame into a room after a void-out with a cucco around (not at Lon Lon Ranch or in the Shadow
+// Temple slot), and with none here, ML spawns its own cucco beside Link, in no room so it follows him. While Link holds
+// a cucco, the health it keeps is recorded; ML's own starts at 0x77.
+static void MlState_CuccoFrame(Player* player, PlayState* play) {
+    if ((gMlRoomFrames == 1) && (play->sceneNum != SCENE_LON_LON_RANCH) && (play->sceneNum != SCENE_SHADOW_TEMPLE) &&
+        (sMlCuccoHealth == 0x77) && !MlCucco_InRoom(play)) {
+        s16 yaw = player->actor.focus.rot.y;
+        Actor* cucco = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_POH, player->actor.world.pos.x + Math_SinS(yaw) * 152.0f,
+                                   player->actor.world.pos.y, player->actor.world.pos.z + Math_CosS(yaw) * 184.0f, 0,
+                                   yaw, 0, 0x77);
+        if (cucco != NULL) {
+            cucco->room = -1;
+        }
+        sMlCuccoVoided = 0;
+    }
+    if (sMlCuccoVoided == 0) {
+        Actor* held = player->actor.child;
+
+        sMlCuccoHealth = 0xFFFF;
+        if ((held != NULL) && MlCucco_Is(held)) {
+            sMlCuccoHealth = held->colChkInfo.health;
+        }
+    }
+}
+
+// Returns whether Player_UpdateCommon should run this frame.
+s32 MlState_PlayerFrame(Player* player, PlayState* play) {
+    s32 runUpdate = false;
+
+    if (gMlRewindStep == 0) {
+        u16 key = play->sceneNum | (play->roomCtx.curRoom.num << 4);
+        u16 frames;
+
+        memmove(&sMlRewind[1], &sMlRewind[0], sizeof(sMlRewind[0]) * (ML_REWIND_LEN - 1));
+        sMlRewind[0].pos = player->actor.world.pos;
+        sMlRewind[0].yaw = player->actor.shape.rot.y;
+
+        if (key != sMlRoomKey) {
+            sMlRoomKey = key;
+            gMlRoomFrames = 0;
+        }
+        frames = gMlRoomFrames + 1;
+        if (frames == 17) {
+            for (s32 i = 0; i < ML_REWIND_LEN; i++) {
+                sMlRewind[i].pos = player->actor.world.pos;
+                sMlRewind[i].yaw = 0; // ML stores the facing as a word here, so it reads back as 0
+            }
+            frames = 178;
+        }
+        gMlRoomFrames = MIN(frames, 169);
+
+        if ((gMlRoomFrames == 169) && gMlHourglassTrigger) {
+            gMlRewindStep = 1;
+            sMlHourglassWipe = Actor_Spawn(&play->actorCtx, play, ACTOR_OCEFF_WIPE, player->actor.world.pos.x,
+                                           player->actor.world.pos.y, player->actor.world.pos.z, 0, 0, 0, 1);
+            Audio_PlayActorSound2(&player->actor, NA_SE_IT_SHIELD_REFLECT_MG);
+        } else {
+            gMlHourglassTrigger = 0;
+            runUpdate = true;
+        }
+    } else {
+        MlRewindEntry* entry;
+
+        gMlRoomFrames = 0;
+        gMlRewindStep += 4;
+        entry = &sMlRewind[64 + gMlRewindStep];
+        player->actor.world.pos = player->actor.home.pos = entry->pos;
+        player->actor.shape.rot.y = entry->yaw;
+        if (sMlHourglassWipe != NULL) {
+            sMlHourglassWipe->world.pos = entry->pos;
+            sMlHourglassWipe->shape.rot.y = entry->yaw;
+        }
+        gMlHourglassTrigger = 0;
+        if (gMlRewindStep == 97) {
+            gMlRewindStep = 0;
+        }
+    }
+    return runUpdate;
+}
+
+// Called after Player_UpdateCommon (or in its place).
+void MlState_PlayerFrameEnd(Player* player, PlayState* play) {
+    MlState_CuccoFrame(player, play);
+}
+
+s32 MlState_SkipWallPush(PlayState* play) {
+    if (gMlRoomFrames < 2) {
+        return true;
+    }
+    if (gMlWallSkip != 0) {
+        gMlWallSkip--;
+        return play->sceneNum == SCENE_LOST_WOODS; // ML's Deep Woods (slot 0x5B)
+    }
+    return false;
+}
+
+// ML's triple jump. ML routes every LinkAnimation_Change call (the player overlay's 29, code's 5) through 0x806023E0.
+// When a running jump starts, it plays sMlJumpAnims[sMlJumpStep] instead: the second and third jumps reuse the two
+// sword-turn recovery slots, whose data ML replaced (gPlayerAnimData_114420 / _114FB0, shipped by MS-026). Its
+// per-frame part (the tail of 0x80602DE0, hooked into the player draw) advances the step after each jump and drops
+// it back to the first jump once Link has been out of all three for 16 frames.
+static const char* sMlJumpAnims[] = {
+    gPlayerAnim_link_normal_run_jump,
+    gPlayerAnim_link_fighter_turn_kiruL_end,
+    gPlayerAnim_link_fighter_turn_kiruR_end,
+};
+static s8 sMlJumpStep = 0;     // 0x80600008
+static s8 sMlJumpPlayed = -1;  // 0x80600004: the jump LinkAnimation_Change just started, as an sMlJumpAnims index
+static u32 sMlJumpTimer = 0;   // 0x80603614: frames since Link left the last jump
+
+// Animations are resource paths here; each file has its own copy of a path, so compare the text.
+static s32 MlAnim_Is(const void* animation, const char* path) {
+    return animation == path || (ResourceMgr_OTRSigCheck((char*)animation) && strcmp(animation, path) == 0);
+}
+
+void MlState_LinkAnimation(LinkAnimationHeader** animation, f32* endFrame) {
+    if (MlAnim_Is(*animation, gPlayerAnim_link_normal_run_jump)) {
+        *animation = (LinkAnimationHeader*)sMlJumpAnims[sMlJumpStep];
+        *endFrame = Animation_GetLastFrame(*animation);
+        sMlJumpPlayed = sMlJumpStep;
+    }
+    // ML's Fishing Pond cutscene entrance: Link only ever plays the horse idle (ML entrance 0x420, see Ml_Fishpond).
+    if (gSaveContext.entranceIndex == MlEntrance_ToSoh(0x420)) {
+        *animation = (LinkAnimationHeader*)gPlayerAnim_link_uma_wait_2;
+        *endFrame = Animation_GetLastFrame(*animation);
+    }
+}
+
+void MlState_JumpUpdate(Player* player) {
+    if (sMlJumpTimer >= 16) {
+        sMlJumpStep = 0;
+    }
+    switch (sMlJumpPlayed) {
+        case 0:
+            sMlJumpStep = 1;
+            sMlJumpTimer = 1;
+            break;
+        case 1:
+            sMlJumpStep = 2;
+            sMlJumpTimer = 1;
+            break;
+        case 2:
+            sMlJumpStep = 0;
+            sMlJumpTimer = 0;
+            break;
+        default:
+            if (sMlJumpStep != 0) {
+                sMlJumpTimer++;
+            }
+            break;
+    }
+    sMlJumpPlayed = -1;
+    for (s32 i = 0; i < ARRAY_COUNT(sMlJumpAnims); i++) {
+        if (MlAnim_Is(player->skelAnime.animation, sMlJumpAnims[i])) {
+            sMlJumpTimer = 0;
+        }
+    }
+}
+
+// ML's Soul-Charged Kokiri Sword (the middle of 0x80602DE0, hooked into the player draw). ML marks the upgrade with
+// slingshot ammo 40. While it is set, ML rewrites object_link_child every frame: the sheath, hilt and blade DLs call
+// the soul sword it appended instead, and the blade's 8 prim colours pulse green while the sword is powered (charging a
+// spin, a combo swing at full health, or normal2fighter_free); otherwise they are white. SoH's DLs are shared
+// resources, so the same edits are patches, undone when the ammo marker is gone.
+static s32 sMlSoulPatched = false;
+static s8 sMlSoulGlowOn = false; // 0x80603610
+static u32 sMlSoulGlowTimer = 0; // 0x8060360C
+static u8 sMlSoulGlow[3] = { 255, 255, 255 }; // 0x80603600
+
+static void MlSoulSword_Redirect(const char* dl, const char* to, s32 on) {
+    if (on) {
+        ResourceMgr_PatchCustomGfxByName(dl, "mlSoulSword0", 0, (Gfx)gsSPDisplayListOTRFilePath(to));
+        ResourceMgr_PatchCustomGfxByName(dl, "mlSoulSword1", 1, (Gfx)gsSPEndDisplayList());
+    } else {
+        ResourceMgr_UnpatchGfxByName(dl, "mlSoulSword0");
+        ResourceMgr_UnpatchGfxByName(dl, "mlSoulSword1");
+    }
+}
+
+static void MlSoulSword_SetBladeColor(u8 r, u8 g, u8 b) {
+    static const char* sPatchNames[] = { "mlSoulGlow0", "mlSoulGlow1", "mlSoulGlow2", "mlSoulGlow3",
+                                         "mlSoulGlow4", "mlSoulGlow5", "mlSoulGlow6", "mlSoulGlow7" };
+    Gfx* gfx = ResourceMgr_LoadGfxByName(gMlChildSoulSwordBladeDL);
+    s32 n = 0;
+
+    if (gfx == NULL) {
+        return;
+    }
+    for (s32 i = 0; (n < ARRAY_COUNT(sPatchNames)) && ((gfx[i].words.w0 >> 24) != G_ENDDL); i++) {
+        u32 op = gfx[i].words.w0 >> 24;
+
+        if (op == G_SETPRIMCOLOR) {
+            ResourceMgr_PatchCustomGfxByName(gMlChildSoulSwordBladeDL, sPatchNames[n++], i,
+                                             (Gfx)gsDPSetPrimColor(0, 0x80, r, g, b, 255));
+        } else if ((op == 0x20) || (op == 0x31) || (op == 0x32) || (op == 0x33) || (op == 0x35) || (op == 0x36) ||
+                   (op == 0x42)) {
+            i++; // LUS's two-word commands
+        }
+    }
+}
+
+void MlSoulSword_Update(Player* player, PlayState* play, s32 inFreeStance) {
+    s32 on = (AMMO(ITEM_SLINGSHOT) == 40);
+    s32 powered;
+
+    if (on != sMlSoulPatched) {
+        MlSoulSword_Redirect(gLinkChildSheathNearDL, gMlChildSoulSheathDL, on);
+        MlSoulSword_Redirect(gMlChildKokiriSwordHiltDL, gMlChildSoulSwordHiltDL, on);
+        MlSoulSword_Redirect(gMlChildKokiriSwordBladeDL, gMlChildSoulSwordBladeDL, on);
+        sMlSoulPatched = on;
+    }
+    if (!on) {
+        return;
+    }
+
+    powered = (player->stateFlags1 & PLAYER_STATE1_CHARGING_SPIN_ATTACK) ||
+              ((player->unk_845 & 1) && (gSaveContext.healthCapacity == gSaveContext.health)) || inFreeStance;
+    if (!powered) {
+        sMlSoulGlow[0] = sMlSoulGlow[1] = sMlSoulGlow[2] = 255;
+        sMlSoulGlowTimer = 0;
+        sMlSoulGlowOn = false;
+    } else if (!sMlSoulGlowOn) {
+        sMlSoulGlow[0] = 0;
+        sMlSoulGlow[1] = 255;
+        sMlSoulGlow[2] = 150;
+        sMlSoulGlowOn = true;
+    } else {
+        s8 step = (sMlSoulGlowTimer < 10) ? -8 : 8;
+
+        sMlSoulGlow[1] += step;
+        sMlSoulGlow[2] += step;
+        if (++sMlSoulGlowTimer == 20) {
+            sMlSoulGlowTimer = 0;
+        }
+    }
+    MlSoulSword_SetBladeColor(sMlSoulGlow[0], sMlSoulGlow[1], sMlSoulGlow[2]);
+}
