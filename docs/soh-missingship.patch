+// comparing the ID with bits 9-11 masked off (0xF1FF).
+static s32 MlAudio_IsMuted(u16 sfxId) {
+    static const u16 sMuted[] = { 0x201B, 0x205F, 0x2071, 0x6040, 0x6041, 0x6042, 0x6043, 0x605F, 0x6073 };
+    size_t i;
