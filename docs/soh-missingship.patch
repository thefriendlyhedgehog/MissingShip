+#ifndef Z_ML_SKULLKID_H
+#define Z_ML_SKULLKID_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+typedef struct MlSkullKid {
+    Actor actor;
+    SkelAnime skelAnime;
+    Vec3s jointTable[19];
+    Vec3s morphTable[19];
+    Actor* flowers[2]; // params 1: the two bomb flowers it spawns
+    s16 state;         // params 2: 0 offer talk, 1 talking, 2 event, 3 give heart, 4 done
+    s16 inContact;     // params 2: the one-frame auto-accept pulse inside 40 units has fired
+} MlSkullKid;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.c b/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.c
new file mode 100644
index 0000000000000000000000000000000000000000..4ca46d7b529cd419de0657714414f2991fd2898f
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.c
@@ -0,0 +1,123 @@
+/*
+ * File: z_ml_slideblock.c
+ * Overlay: ovl_Ml_SlideBlock
+ * Description: The Missing Link - a switch-driven sliding block (ML's rewrite of Boss_Tw, slot 0x0DC)
+ *
+ * Source overlay: ML dma 234, text 0x490, hand-written. Placed 26 times in HAKAdan, all on room switch 0x20.
+ * params: low byte = switch flag. High byte: bit 0 inverts the switch (and draws teal instead of orange),
+ * bit 1 picks the second model and collision, bit 4 the third/fourth model, bit 5 scale 1.0 instead of 0.5.
+ * When the switch (xor the invert bit) is set the block slides 10 frames of 20 units x scale along its own down
+ * axis; when it clears, it slides back. It starts out already moved if the switch is set on load.
+ */
+
+#include "z_ml_slideblock.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+#define ML_HB(thisx) (((thisx)->params >> 8) & 0xFF)
+
+void MlSlideBlock_Init(Actor* thisx, PlayState* play);
+void MlSlideBlock_Destroy(Actor* thisx, PlayState* play);
+void MlSlideBlock_Update(Actor* thisx, PlayState* play);
+void MlSlideBlock_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_SlideBlock_InitVars = {
+    ACTOR_BOSS_TW,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_TW,
+    sizeof(MlSlideBlock),
+    (ActorFunc)MlSlideBlock_Init,
+    (ActorFunc)MlSlideBlock_Destroy,
+    (ActorFunc)MlSlideBlock_Update,
+    (ActorFunc)MlSlideBlock_Draw,
+    NULL,
+};
+
+static InitChainEntry sInitChain[] = {
+    ICHAIN_VEC3F_DIV1000(scale, 100, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneForward, 12800, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneScale, 1300, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneDownward, 1300, ICHAIN_STOP),
+};
+
+// Each ML display list sets the primitive colour, then branches to one of four models.
+static Gfx* sDLists[] = {
+    (Gfx*)gMlSlideBlock0DL, (Gfx*)gMlSlideBlock1DL, (Gfx*)gMlSlideBlock2DL, (Gfx*)gMlSlideBlock3DL,
+    (Gfx*)gMlSlideBlock4DL, (Gfx*)gMlSlideBlock5DL, (Gfx*)gMlSlideBlock6DL, (Gfx*)gMlSlideBlock7DL,
+};
+
+static s32 MlSlideBlock_SwitchOn(MlSlideBlock* this, PlayState* play) {
+    s32 flag = Flags_GetSwitch(play, this->dyna.actor.params & 0xFF);
+
+    return (ML_HB(&this->dyna.actor) & 1) ? !flag : flag;
+}
+
+void MlSlideBlock_Init(Actor* thisx, PlayState* play) {
+    MlSlideBlock* this = (MlSlideBlock*)thisx;
+    s32 hb = ML_HB(thisx);
+    CollisionHeader* colHeader = NULL;
+    f32 side;
+    f32 back;
+
+    Actor_ProcessInitChain(thisx, sInitChain);
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    Actor_SetScale(thisx, (hb & 0x20) ? 1.0f : 0.5f);
+    CollisionHeader_GetVirtual((hb & 2) ? gMlSlideBlock1Col : gMlSlideBlock0Col, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
+
+    // The block's local down axis, 20 units long at scale 1.0
+    side = Math_SinS(thisx->shape.rot.z) * 20.0f;
+    back = Math_SinS(thisx->shape.rot.x) * 20.0f;
+    this->step.x = (side * Math_SinS(thisx->shape.rot.y + 0x3FFF) + back * Math_SinS(thisx->shape.rot.y + 0x7FFF)) *
+                   thisx->scale.x;
+    this->step.y = Math_CosS(thisx->shape.rot.z) * (-20.0f * thisx->scale.x) * Math_CosS(thisx->shape.rot.x);
+    this->step.z = (side * Math_CosS(thisx->shape.rot.y + 0x3FFF) + back * Math_CosS(thisx->shape.rot.y + 0x7FFF)) *
+                   thisx->scale.x;
+
+    if (MlSlideBlock_SwitchOn(this, play)) {
+        thisx->world.pos.x += this->step.x * 10.0f;
+        thisx->world.pos.y += this->step.y * 10.0f;
+        thisx->world.pos.z += this->step.z * 10.0f;
+        this->isOut = true;
+    }
+}
+
+void MlSlideBlock_Destroy(Actor* thisx, PlayState* play) {
+    MlSlideBlock* this = (MlSlideBlock*)thisx;
+
+    DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+}
+
+void MlSlideBlock_Update(Actor* thisx, PlayState* play) {
+    MlSlideBlock* this = (MlSlideBlock*)thisx;
+
+    if (this->state == 1 || this->state == 2) {
+        f32 dir = (this->state == 2) ? 1.0f : -1.0f;
+
+        thisx->world.pos.x += this->step.x * dir;
+        thisx->world.pos.y += this->step.y * dir;
+        thisx->world.pos.z += this->step.z * dir;
+        if (--this->timer == 0) {
+            this->isOut = (this->state == 2);
+            this->state = 0;
+        }
+    } else if (MlSlideBlock_SwitchOn(this, play)) {
+        if (!this->isOut) {
+            this->state = 2;
+            this->timer = 10;
+            SoundSource_PlaySfxAtFixedWorldPos(play, &thisx->world.pos, 30, NA_SE_EV_METALDOOR_OPEN);
+        }
+    } else if (this->isOut) {
+        this->state = 1;
+        this->timer = 10;
+        SoundSource_PlaySfxAtFixedWorldPos(play, &thisx->world.pos, 30, NA_SE_EV_METALDOOR_CLOSE);
+    }
+}
+
+void MlSlideBlock_Draw(Actor* thisx, PlayState* play) {
+    s32 hb = ML_HB(thisx);
+
+    Gfx_DrawDListOpa(play, sDLists[(hb & 1) * 2 + ((hb >> 1) & 1) + ((hb >> 4) & 1) * 4]);
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.h b/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.h
new file mode 100644
index 0000000000000000000000000000000000000000..1018260e3e6f5b98cfa6e2ad6c8ac5dc22fbb891
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_SlideBlock/z_ml_slideblock.h
@@ -0,0 +1,16 @@
+#ifndef Z_ML_SLIDEBLOCK_H
+#define Z_ML_SLIDEBLOCK_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+// ML's layout (size 0x1A0), for reference against its overlay; SoH's own offsets differ.
+typedef struct MlSlideBlock {
+    /* 0x000 */ DynaPolyActor dyna;
+    /* 0x180 */ s8 state;   // 0 idle, 1 sliding back, 2 sliding out
+    /* 0x181 */ s8 timer;
+    /* 0x182 */ s8 isOut;
+    /* 0x18C */ Vec3f step; // one frame of travel along the block's own down axis
+} MlSlideBlock;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c b/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c
new file mode 100644
index 0000000000000000000000000000000000000000..92ffb7c1085a8ad22b6d07db6b98121b5b983ae7
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c
@@ -0,0 +1,96 @@
+/*
+ * File: z_ml_songblock.c
+ * Overlay: ovl_Ml_SongBlock
+ * Description: The Missing Link - the block sealing the way to Saria's house until a song is played
+ *
+ * ML rewrote Obj_Timeblock (slot 0x1D1) wholesale: 608 bytes of text against vanilla's 2864, no Song of Time
+ * logic at all. It draws and collides from ML's refilled object_ouke_haka (0x18F) and, on Init, places a
+ * vanilla En_Okarina_Tag (params 0x1C0C: switch 0x0C) at fixed Kokiri Forest coordinates. Playing the song
+ * there sets switch 0x0C; the block then shows a Magic_Wind sparkle and, after 30 frames, sinks 2 units per
+ * frame for 150 frames under a short cutscene before removing itself.
+ */
+
+#include "z_ml_songblock.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+#define ML_SONGBLOCK_SWITCH 0x0C
+
+void MlSongBlock_Init(Actor* thisx, PlayState* play);
+void MlSongBlock_Destroy(Actor* thisx, PlayState* play);
+void MlSongBlock_Update(Actor* thisx, PlayState* play);
+void MlSongBlock_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_SongBlock_InitVars = {
+    ACTOR_OBJ_TIMEBLOCK,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_OUKE_HAKA,
+    sizeof(MlSongBlock),
+    (ActorFunc)MlSongBlock_Init,
+    (ActorFunc)MlSongBlock_Destroy,
+    (ActorFunc)MlSongBlock_Update,
+    (ActorFunc)MlSongBlock_Draw,
+    NULL,
+};
+
+void MlSongBlock_Init(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+    CollisionHeader* colHeader = NULL;
+
+    if (Flags_GetSwitch(play, ML_SONGBLOCK_SWITCH)) {
+        this->killedAtInit = true;
+        Actor_Kill(thisx);
+        return;
+    }
+
+    Actor_SetScale(thisx, 1.0f);
+    thisx->uncullZoneForward = 2000.0f;
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    CollisionHeader_GetVirtual(gMlSongBlockCol, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
+
+    // ML hardcodes where the song must be played.
+    Actor_Spawn(&play->actorCtx, play, ACTOR_EN_OKARINA_TAG, 1128.0f, 268.0f, -1370.0f, 0, thisx->world.rot.y, 0,
+                0x1C0C);
+}
+
+void MlSongBlock_Destroy(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+
+    if (!this->killedAtInit) {
+        DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+    }
+}
+
+void MlSongBlock_Update(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+
+    if (this->state == 1) {
+        this->sparkle = Actor_Spawn(&play->actorCtx, play, ACTOR_MAGIC_WIND, thisx->world.pos.x, thisx->world.pos.y,
+                                    thisx->world.pos.z, 0, 0, 0, 0);
+        this->state = 2;
+    } else if (this->state == 2) {
+        Camera_ChangeDataIdx(&play->mainCamera, 3);
+        func_80064520(play, &play->csCtx);
+        this->timer++;
+        if (this->timer >= 31) {
+            thisx->world.pos.y -= 2.0f;
+            Player_PlaySfx(thisx, 0x208F);
+            if (this->timer >= 181) {
+                func_80064534(play, &play->csCtx);
+                if (this->sparkle != NULL) {
+                    Actor_Kill(this->sparkle);
+                }
+                Actor_Kill(thisx);
+            }
+        }
+    } else if (Flags_GetSwitch(play, ML_SONGBLOCK_SWITCH)) {
+        this->state = 1;
+    }
+}
+
