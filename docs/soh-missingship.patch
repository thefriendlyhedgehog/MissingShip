+// Generated from ML dma 105 (actor 0x005) overlay data +0x68C by MissingShip/tools; do not edit.
+static Vec3s sMlTreeBridgeVtx[] = {
+    { 53, 0, 34 },
+    { 36, 13, 16 },
+    { 32, 27, 22 },
+    { 28, 13, 29 },
+    { -2, 0, 2 },
+    { -37, 27, 22 },
