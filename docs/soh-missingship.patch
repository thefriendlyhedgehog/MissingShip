index 0000000000000000000000000000000000000000..711748ea3c653d8026cede0ee7fcd9ebd8d7ceec
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.c
@@ -0,0 +1,251 @@
+/*
+ * File: z_ml_hintnuts.c
+ * Overlay: ovl_Ml_HintNuts
+ * Description: The Missing Link - talking Deku Scrubs (ML's rewrite of En_Hintnuts, slot 0x192)
+ *
+ * ML replaced the Deku Tree's hint scrubs (ML dma 300, text 0x7F0) with friendly NPCs. params select the variant:
+ *   0x1017, 0x1018  the pair guarding the path to the Deku Grove in Deep Woods. They use ML's own object 0x005
+ *                   (object_ml_scrub) and leave once Link owns the Deku Pass (the Gerudo Card quest slot).
+ *   0x901B/0x901C,  scrubs on vanilla's object_hintnuts. The Deku Brothers' lines change once switch 5 is set;
+ *   0x9024-0x9026,  0x502D answers differently to the Bunny Hood.
+ *   0x502D
+ *   10, 11          props the scrubs spawn under themselves: a flower (vanilla object) or a pedestal (object 5).
+ * They pop up, face Link within 130 units and talk within 60, swapping to a talking animation while the textbox
+ * is open.
+ */
+
+#include "z_ml_hintnuts.h"
+#include "objects/object_hintnuts/object_hintnuts.h"
+#include "assets/ml_assets.h"
+#include "soh/ResourceManagerHelpers.h"
+
+#define FLAGS ACTOR_FLAG_ATTENTION_ENABLED
+
+#define ML_HINTNUTS_FLOWER 10
+#define ML_HINTNUTS_PEDESTAL 11
+#define ML_HINTNUTS_IS_GUARD(params) ((u16)(params) == 0x1017 || (u16)(params) == 0x1018)
+#define ML_HINTNUTS_IS_PROP(params) ((u16)(params) == ML_HINTNUTS_FLOWER || (u16)(params) == ML_HINTNUTS_PEDESTAL)
+
+void MlHintNuts_Init(Actor* thisx, PlayState* play);
+void MlHintNuts_Destroy(Actor* thisx, PlayState* play);
+void MlHintNuts_Update(Actor* thisx, PlayState* play);
+void MlHintNuts_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_HintNuts_InitVars = {
+    ACTOR_EN_HINTNUTS,
+    ACTORCAT_NPC,
+    FLAGS,
+    OBJECT_HINTNUTS,
+    sizeof(MlHintNuts),
+    (ActorFunc)MlHintNuts_Init,
+    (ActorFunc)MlHintNuts_Destroy,
+    (ActorFunc)MlHintNuts_Update,
+    (ActorFunc)MlHintNuts_Draw,
+    NULL,
+};
+
+// ML overlay data +0x830.
+static ColliderCylinderInit sCylinderInit = {
+    {
+        COLTYPE_NONE,
+        AT_ON | AT_TYPE_ENEMY,
+        AC_NONE,
+        OC1_ON | OC1_TYPE_PLAYER,
+        OC2_TYPE_2,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0xFFCFFFFF, 0x04, 0x05 },
+        { 0xFFCFFFFF, 0x00, 0x00 },
+        TOUCH_ON,
+        BUMP_ON,
+        OCELEM_ON,
+    },
+    { 35, 32, 0, { 0, 0, 0 } },
+};
+
+static void* sGuardEyeTextures[] = { gMlScrubEyeOpenTex, gMlScrubEyeHalfTex, gMlScrubEyeClosedTex };
+
+void MlHintNuts_Init(Actor* thisx, PlayState* play) {
+    MlHintNuts* this = (MlHintNuts*)thisx;
+    u16 params = thisx->params;
+
+    if (params == ML_HINTNUTS_PEDESTAL) {
+        thisx->flags &= ~(ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_HOSTILE);
+        Actor_SetScale(thisx, 0.013f);
+    } else if (params == ML_HINTNUTS_FLOWER) {
+        thisx->flags &= ~(ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_HOSTILE);
+    } else if (ML_HINTNUTS_IS_GUARD(params)) {
+        if (CHECK_QUEST_ITEM(QUEST_GERUDO_CARD)) { // ML's Deku Pass
+            Actor_Kill(thisx);
+            return;
+        }
+        SkelAnime_Init(play, &this->skelAnime, (SkeletonHeader*)gMlScrubSkel, (AnimationHeader*)gMlScrubIdleAnim,
+                       NULL, NULL, 0);
+        Animation_PlayOnceSetSpeed(&this->skelAnime, (AnimationHeader*)gMlScrubIdleAnim, 0.0f);
+        Animation_MorphToLoop(&this->skelAnime, (AnimationHeader*)gMlScrubIdleAnim, -5.0f);
+        Actor_SpawnAsChild(&play->actorCtx, thisx, play, ACTOR_EN_HINTNUTS, thisx->world.pos.x, thisx->world.pos.y,
+                           thisx->world.pos.z, 0, thisx->shape.rot.y, 0, ML_HINTNUTS_PEDESTAL);
+        Actor_SetScale(thisx, 0.013f);
+        Actor_SetFocus(thisx, 35.0f);
+    } else {
+        Actor_SetFocus(thisx, 20.0f);
+        SkelAnime_Init(play, &this->skelAnime, &gHintNutsSkel, &gHintNutsStandAnim, NULL, NULL, 0);
+        Animation_PlayOnceSetSpeed(&this->skelAnime, &gHintNutsUpAnim, 0.0f);
+        Actor_SpawnAsChild(&play->actorCtx, thisx, play, ACTOR_EN_HINTNUTS, thisx->world.pos.x, thisx->world.pos.y,
+                           thisx->world.pos.z, 0, thisx->shape.rot.y, 0, ML_HINTNUTS_FLOWER);
+    }
+
+    Collider_InitCylinder(play, &this->collider);
+    Collider_SetCylinder(play, &this->collider, thisx, &sCylinderInit);
+    this->collider.dim.height = 5;
+}
+
+void MlHintNuts_Destroy(Actor* thisx, PlayState* play) {
+    MlHintNuts* this = (MlHintNuts*)thisx;
+
+    if (!ML_HINTNUTS_IS_PROP(thisx->params)) {
+        Collider_DestroyCylinder(play, &this->collider);
+        if (this->skelAnime.skeleton != NULL) { // a guard that left at Init never built its skeleton
+            ResourceMgr_UnregisterSkeleton(&this->skelAnime);
+        }
+    }
+}
+
+// ML +0x398: the vanilla-model scrubs pop out of the ground on their first update.
+static void MlHintNuts_StandUp(MlHintNuts* this) {
+    f32 frame = this->skelAnime.curFrame;
+
+    if (frame < 9.0f) {
+        this->collider.dim.height = 5;
+    } else if (frame > 12.0f) {
+        this->collider.dim.height = 32;
+    } else {
+        this->collider.dim.height = (s16)((frame - 9.0f) * 9.0f + 5.0f);
+    }
+    Animation_MorphToLoop(&this->skelAnime, &gHintNutsStandAnim, -5.0f);
+    this->standing = true;
+}
+
+static u16 MlHintNuts_GetTextId(MlHintNuts* this, PlayState* play) {
+    switch ((u16)this->actor.params) {
+        case 0x901B:
+            return Flags_GetSwitch(play, 5) ? 0x101D : 0x101B;
+        case 0x901C:
+            return Flags_GetSwitch(play, 5) ? 0x101E : 0x101C;
+        case 0x9024:
+            return 0x1024;
+        case 0x9025:
+            return 0x1025;
+        case 0x9026:
+            return 0x1026;
+        case 0x1017:
+            return 0x1017;
+        case 0x1018:
+            return 0x1018;
+        case 0x502D:
+            return (Player_GetMask(play) == PLAYER_MASK_BUNNY) ? 0x102E : 0x102D;
+        default:
+            return this->actor.textId;
+    }
+}
+
+void MlHintNuts_Update(Actor* thisx, PlayState* play) {
+    MlHintNuts* this = (MlHintNuts*)thisx;
+    bool guard = ML_HINTNUTS_IS_GUARD(thisx->params);
+
+    if (ML_HINTNUTS_IS_PROP(thisx->params)) {
+        return;
+    }
+
+    if (!this->standing && !guard) {
+        MlHintNuts_StandUp(this);
+    }
+
+    Collider_UpdateCylinder(thisx, &this->collider);
+    CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
+
+    thisx->textId = MlHintNuts_GetTextId(this, play);
+
+    if (thisx->xzDistToPlayer < 60.0f) {
+        if (this->talkState == 1) {
+            if (guard) {
+                Animation_MorphToLoop(&this->skelAnime, (AnimationHeader*)gMlScrubTalkAnim, -5.0f);
+                Player_PlaySfx(thisx, 0x387E);
+            } else {
+                Animation_MorphToLoop(&this->skelAnime, &gHintNutsTalkAnim, -5.0f);
+            }
+            this->talkState = 2;
+        } else if (this->talkState == 2) {
+            if (Message_GetState(&play->msgCtx) == TEXT_STATE_NONE) {
+                if (guard) {
+                    Animation_MorphToLoop(&this->skelAnime, (AnimationHeader*)gMlScrubIdleAnim, -5.0f);
+                } else {
+                    Animation_MorphToLoop(&this->skelAnime, &gHintNutsStandAnim, -5.0f);
+                }
+                Player_PlaySfx(thisx, 0x3880);
+                this->talkState = 0;
+            }
+        } else if (Message_GetState(&play->msgCtx) != TEXT_STATE_NONE) {
+            this->talkState = 1;
+        }
+
+        // Stepping inside 40 units auto-accepts the talk for exactly one frame.
+        if (thisx->xzDistToPlayer < 40.0f) {
+            if (!this->inContact) {
+                thisx->flags |= ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+                this->inContact = true;
+            } else {
+                thisx->flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+            }
+        } else {
+            thisx->flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+            this->inContact = false;
+        }
+        func_8002F2F4(thisx, play);
+    }
+
+    if (thisx->xzDistToPlayer < 130.0f) {
+        Math_SmoothStepToS(&thisx->shape.rot.y, thisx->yawTowardsPlayer, 3, 0x400, 0x100);
+    }
+
+    if (this->skelAnime.animation != (AnimationHeader*)gMlScrubTalkAnim ||
+        this->skelAnime.curFrame != this->skelAnime.endFrame) {
+        SkelAnime_Update(&this->skelAnime);
+    }
+
+    if (guard) {
+        s16 frame;
+
+        if (this->blinkTimer == 0) {
+            this->blinkTimer = Rand_S16Offset(30, 30);
+        }
+        this->blinkTimer--;
+        frame = (this->blinkTimer < 2) ? (2 - this->blinkTimer) : 0;
+        this->eyeTex = sGuardEyeTextures[frame];
+    }
+}
+
+void MlHintNuts_Draw(Actor* thisx, PlayState* play) {
+    MlHintNuts* this = (MlHintNuts*)thisx;
+
+    if (this->eyeTex != NULL) {
+        OPEN_DISPS(play->state.gfxCtx);
+        gSPSegment(POLY_OPA_DISP++, 0x08, this->eyeTex);
+        gSPSegment(POLY_XLU_DISP++, 0x08, this->eyeTex);
+        CLOSE_DISPS(play->state.gfxCtx);
+    }
+
+    switch ((u16)thisx->params) {
+        case ML_HINTNUTS_FLOWER:
+            Gfx_DrawDListOpa(play, gHintNutsFlowerDL);
+            break;
+        case ML_HINTNUTS_PEDESTAL:
+            Gfx_DrawDListOpa(play, (Gfx*)gMlScrubPedestalDL);
+            break;
+        default:
+            SkelAnime_DrawOpa(play, this->skelAnime.skeleton, this->skelAnime.jointTable, NULL, NULL, this);
+            break;
+    }
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.h b/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.h
new file mode 100644
index 0000000000000000000000000000000000000000..f41c2e6a029d85b7bcb0c1a615f06569da28d521
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.h
@@ -0,0 +1,18 @@
+#ifndef Z_ML_HINTNUTS_H
+#define Z_ML_HINTNUTS_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+typedef struct MlHintNuts {
+    Actor actor;
+    SkelAnime skelAnime;
+    s8 standing;    // the first-frame pop-up has run (vanilla-model variants)
+    ColliderCylinder collider;
+    s8 talkState;   // 0 idle, 1 conversation opened, 2 talking
+    s8 inContact;   // inside 40 units: one-frame auto-accept pulse has fired
+    void* eyeTex;
+    s16 blinkTimer;
+} MlHintNuts;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_HoleScrub/z_ml_holescrub.c b/soh/src/overlays/actors/ovl_Ml_HoleScrub/z_ml_holescrub.c
new file mode 100644
index 0000000000000000000000000000000000000000..b6b87c33212fed327aebadd4bb21d32b6f65bc8a
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_HoleScrub/z_ml_holescrub.c
@@ -0,0 +1,397 @@
+/*
+ * File: z_ml_holescrub.c
+ * Overlay: ovl_Ml_HoleScrub
+ * Description: The Missing Link - the hole-hopping Deku Scrub (ML's recompiled En_Hintnuts in En_Weiyer's slot 0x18C)
+ *
+ * ML dma 298: vanilla En_Hintnuts rebuilt with changes, placed in its Deku Tree-slot scene (room 2) on one of three
+ * Deku flowers (En_Dekunuts params 10) beside two push blocks. It never throws nuts or walks: it faces you, turns
+ * away and talks when you come within 30 units (text = params & 0x7FFF; +2 with bit 15 once switch 5 is set;
+ * 0x1023 once room 0 is cleared), and when hit it burrows and pops up on a random flower that no push block
+ * (Obj_Oshihiki) stands within 30 units of. With fewer than two open flowers it is caught: switch 15 is set and it is
+ * gone for good. While loaded it also sinks every other enemy-category actor to y -960, hiding the Deku scrub bodies
+ * so only their flowers remain.
+ *
+ * Vanilla paths ML's changes make unreachable (nut throwing, the enemy-only freeze puzzle) are left out.
+ */
+
+#include "z_ml_holescrub.h"
+#include "objects/object_hintnuts/object_hintnuts.h"
+#include "soh/ResourceManagerHelpers.h"
+
+#define FLAGS ACTOR_FLAG_HOSTILE
+
+#define ML_HOLESCRUB_CAUGHT_SWITCH 15
+
+void MlHoleScrub_Init(Actor* thisx, PlayState* play);
+void MlHoleScrub_Destroy(Actor* thisx, PlayState* play);
+void MlHoleScrub_Update(Actor* thisx, PlayState* play);
+void MlHoleScrub_Draw(Actor* thisx, PlayState* play);
+
+static void MlHoleScrub_Wait(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_LookAround(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_Stand(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_Burrow(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_BeginRun(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_Run(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_Talk(MlHoleScrub* this, PlayState* play);
+static void MlHoleScrub_Leave(MlHoleScrub* this, PlayState* play);
+
+const ActorInit Ml_HoleScrub_InitVars = {
+    ACTOR_EN_WEIYER,
+    ACTORCAT_NPC,
+    FLAGS,
+    OBJECT_HINTNUTS,
+    sizeof(MlHoleScrub),
+    (ActorFunc)MlHoleScrub_Init,
+    (ActorFunc)MlHoleScrub_Destroy,
+    (ActorFunc)MlHoleScrub_Update,
+    (ActorFunc)MlHoleScrub_Draw,
+    NULL,
+};
+
+static ColliderCylinderInit sCylinderInit = {
+    {
+        COLTYPE_HIT6,
+        AT_NONE,
+        AC_ON | AC_TYPE_PLAYER,
+        OC1_ON | OC1_TYPE_ALL,
+        OC2_TYPE_1,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0x00000000, 0x00, 0x00 },
+        { 0xFFCFFFFF, 0x00, 0x00 },
+        TOUCH_NONE,
+        BUMP_ON,
+        OCELEM_ON,
+    },
+    { 18, 32, 0, { 0, 0, 0 } },
+};
+
+static CollisionCheckInfoInit sColChkInfoInit = { 1, 18, 32, MASS_HEAVY };
+
+static InitChainEntry sInitChain[] = {
+    ICHAIN_F32(gravity, -1, ICHAIN_CONTINUE),
+    ICHAIN_S8(naviEnemyId, 0x0A, ICHAIN_CONTINUE),
+    ICHAIN_F32(targetArrowOffset, 2600, ICHAIN_STOP),
+};
+
+static void MlHoleScrub_SetupWait(MlHoleScrub* this) {
+    Animation_PlayOnceSetSpeed(&this->skelAnime, &gHintNutsUpAnim, 0.0f);
+    this->animFlagAndTimer = Rand_S16Offset(100, 50);
+    this->collider.dim.height = 5;
+    this->actor.world.pos.y = this->actor.home.pos.y; // ML keeps x/z: the scrub has moved to another flower
+    this->collider.base.acFlags &= ~AC_ON;
+    this->actionFunc = MlHoleScrub_Wait;
+}
+
+void MlHoleScrub_Init(Actor* thisx, PlayState* play) {
+    MlHoleScrub* this = (MlHoleScrub*)thisx;
+
+    Actor_ProcessInitChain(&this->actor, sInitChain);
+    if (Flags_GetSwitch(play, ML_HOLESCRUB_CAUGHT_SWITCH)) {
+        Actor_Kill(&this->actor);
+        return;
+    }
+    ActorShape_Init(&this->actor.shape, 0x0, ActorShadow_DrawCircle, 35.0f);
+    SkelAnime_Init(play, &this->skelAnime, &gHintNutsSkel, &gHintNutsStandAnim, this->jointTable, this->morphTable, 10);
+    Collider_InitCylinder(play, &this->collider);
+    Collider_SetCylinder(play, &this->collider, &this->actor, &sCylinderInit);
+    CollisionCheck_SetInfo(&this->actor.colChkInfo, NULL, &sColChkInfoInit);
+    this->textIdCopy = this->actor.textId;
+    MlHoleScrub_SetupWait(this);
+}
+
+void MlHoleScrub_Destroy(Actor* thisx, PlayState* play) {
+    MlHoleScrub* this = (MlHoleScrub*)thisx;
+
+    Collider_DestroyCylinder(play, &this->collider);
+    ResourceMgr_UnregisterSkeleton(&this->skelAnime);
+}
+
+static void MlHoleScrub_SetupStand(MlHoleScrub* this) {
+    Animation_MorphToLoop(&this->skelAnime, &gHintNutsStandAnim, -3.0f);
+    this->animFlagAndTimer = 1;
+    this->actionFunc = MlHoleScrub_Stand;
+}
+
+static void MlHoleScrub_SetupBurrow(MlHoleScrub* this) {
+    Animation_MorphToPlayOnce(&this->skelAnime, &gHintNutsBurrowAnim, -5.0f);
+    Audio_PlayActorSound2(&this->actor, NA_SE_EN_NUTS_DOWN);
+    this->actionFunc = MlHoleScrub_Burrow;
+}
+
+static void MlHoleScrub_SetupRun(MlHoleScrub* this) {
+    this->animFlagAndTimer = 5; // ML drops the run animation and never moves the scrub
+    this->actionFunc = MlHoleScrub_Run;
+}
+
+static void MlHoleScrub_SetupLeave(MlHoleScrub* this) {
+    // ML keeps only the bookkeeping: no run animation, no speed, no recovery heart.
+    this->collider.base.ocFlags1 &= ~OC1_ON;
+    this->actor.flags |= ACTOR_FLAG_UPDATE_CULLING_DISABLED;
+    this->animFlagAndTimer = 100;
+    this->actor.world.rot.y = this->actor.shape.rot.y;
+    Audio_PlayActorSound2(&this->actor, NA_SE_EN_NUTS_DAMAGE);
+    this->actionFunc = MlHoleScrub_Leave;
+}
+
+static void MlHoleScrub_Wait(MlHoleScrub* this, PlayState* play) {
+    s32 hasSlowPlaybackSpeed = this->skelAnime.playSpeed < 0.5f;
+
+    if (hasSlowPlaybackSpeed && (this->animFlagAndTimer != 0)) {
+        this->animFlagAndTimer--;
+    }
+    if (Animation_OnFrame(&this->skelAnime, 9.0f)) {
+        this->collider.base.acFlags |= AC_ON;
+    } else if (Animation_OnFrame(&this->skelAnime, 8.0f)) {
+        Audio_PlayActorSound2(&this->actor, NA_SE_EN_NUTS_UP);
+    }
+    this->collider.dim.height = 5.0f + ((CLAMP(this->skelAnime.curFrame, 9.0f, 12.0f) - 9.0f) * 9.0f);
+    // ML removed both "player within 120 -> burrow" reactions: a nearby player just keeps it up.
+    if (SkelAnime_Update(&this->skelAnime) && !(this->actor.xzDistToPlayer < 120.0f)) {
+        if ((this->animFlagAndTimer == 0) && (this->actor.xzDistToPlayer > 320.0f)) {
+            Animation_PlayLoop(&this->skelAnime, &gHintNutsLookAroundAnim);
+            this->animFlagAndTimer = 2;
+            this->actionFunc = MlHoleScrub_LookAround;
+        } else {
+            MlHoleScrub_SetupStand(this);
+        }
+    }
+    if (hasSlowPlaybackSpeed && 160.0f < this->actor.xzDistToPlayer && fabsf(this->actor.yDistToPlayer) < 120.0f &&
+        ((this->animFlagAndTimer == 0) || (this->actor.xzDistToPlayer < 480.0f))) {
+        this->skelAnime.playSpeed = 1.0f;
+    }
+}
+
+static void MlHoleScrub_LookAround(MlHoleScrub* this, PlayState* play) {
+    SkelAnime_Update(&this->skelAnime);
+    if (Animation_OnFrame(&this->skelAnime, 0.0f) && this->animFlagAndTimer != 0) {
+        this->animFlagAndTimer--;
+    }
+    if ((this->actor.xzDistToPlayer < 120.0f) || (this->animFlagAndTimer == 0)) {
+        this->actionFunc = MlHoleScrub_Stand; // ML: straight to standing, no burrow
+    }
+}
+
+static void MlHoleScrub_Stand(MlHoleScrub* this, PlayState* play) {
+    this->collider.base.ocFlags1 |= OC1_ON; // ML: restores the push-out SetupLeave cleared
+    SkelAnime_Update(&this->skelAnime);
+    if (Animation_OnFrame(&this->skelAnime, 0.0f) && this->animFlagAndTimer != 0) {
+        this->animFlagAndTimer--;
+    }
+    if (!(this->animFlagAndTimer & 0x1000)) {
+        Math_ApproachS(&this->actor.shape.rot.y, this->actor.yawTowardsPlayer, 2, 0xE38);
+    }
+    if (this->actor.xzDistToPlayer < 30.0f) {
+        MlHoleScrub_SetupRun(this);
+    }
+}
+
+// ML's addition at Burrow frame 4: hop to a random open flower, or be caught.
+static void MlHoleScrub_Hop(MlHoleScrub* this, PlayState* play) {
+    Actor* holes[4] = { NULL, NULL, NULL, NULL };
+    s32 count = 0;
+    Actor* flower;
+    Actor* prop;
+    s32 tries;
+
+    for (flower = play->actorCtx.actorLists[ACTORCAT_ENEMY].head; flower != NULL; flower = flower->next) {
+        s32 blocked = false;
+
+        if (flower->id != ACTOR_EN_DEKUNUTS || flower->params != 10) {
+            continue;
+        }
+        for (prop = play->actorCtx.actorLists[ACTORCAT_PROP].head; prop != NULL; prop = prop->next) {
+            if (prop->id == ACTOR_OBJ_OSHIHIKI && Actor_WorldDistXZToActor(prop, flower) < 30.0f) {
+                blocked = true;
+                break;
+            }
+        }
+        if (!blocked && count < ARRAY_COUNT(holes)) {
+            holes[count++] = flower;
+        }
+    }
+
+    if (holes[1] == NULL) {
+        Flags_SetSwitch(play, ML_HOLESCRUB_CAUGHT_SWITCH);
+        Audio_PlayActorSound2(&this->actor, NA_SE_EN_NUTS_DAMAGE);
+        Actor_Kill(&this->actor);
+        return;
+    }
+    // ML draws among the first three and retries without a bound; cap it here.
+    for (tries = 0; tries < 64; tries++) {
+        Actor* hole = holes[Rand_S16Offset(0, 3)];
+
+        if (hole != NULL && !(Actor_WorldDistXZToActor(hole, &this->actor) < 30.0f)) {
+            this->actor.world.pos.x = hole->world.pos.x;
+            this->actor.world.pos.z = hole->world.pos.z;
+            return;
+        }
+    }
+}
+
+static void MlHoleScrub_Burrow(MlHoleScrub* this, PlayState* play) {
+    if (SkelAnime_Update(&this->skelAnime)) {
+        MlHoleScrub_SetupWait(this);
+    } else {
+        this->collider.dim.height = 5.0f + ((3.0f - CLAMP(this->skelAnime.curFrame, 1.0f, 3.0f)) * 12.0f);
+    }
+    if (Animation_OnFrame(&this->skelAnime, 4.0f)) {
+        this->collider.base.acFlags &= ~AC_ON;
+        MlHoleScrub_Hop(this, play);
+    }
+}
+
+static void MlHoleScrub_BeginRun(MlHoleScrub* this, PlayState* play) {
+    if (SkelAnime_Update(&this->skelAnime)) {
+        this->runYaw = this->actor.yawTowardsPlayer + 0x8000;
+        MlHoleScrub_SetupRun(this);
+    }
+    Math_ApproachS(&this->actor.shape.rot.y, this->actor.yawTowardsPlayer, 2, 0xE38);
+}
+
+static void MlHoleScrub_CheckProximity(MlHoleScrub* this, PlayState* play) {
+    u16 textId;
+
+    if ((this->collider.base.ocFlags1 & OC1_HIT) || this->actor.isTargeted) {
+        this->actor.flags |= ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+    } else {
+        this->actor.flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+    }
+    if (this->actor.xzDistToPlayer < 130.0f) {
+        textId = this->actor.params & 0x7FFF;
+        if (this->actor.params & 0x8000) {
+            if (Flags_GetSwitch(play, 5)) {
+                textId += 2;
+            }
+        } else if (Flags_GetClear(play, 0)) {
+            textId = 0x1023;
+        }
+        this->actor.textId = textId;
+        func_8002F2F4(&this->actor, play);
+    }
+}
+
+static void MlHoleScrub_Run(MlHoleScrub* this, PlayState* play) {
+    SkelAnime_Update(&this->skelAnime);
+    if (this->animFlagAndTimer != 0) { // ML counts every frame (its Animation_OnFrame test is gone)
+        this->animFlagAndTimer--;
+    }
+    Math_StepToF(&this->actor.speedXZ, 7.5f, 1.0f);
+    if (Math_SmoothStepToS(&this->actor.world.rot.y, this->runYaw, 1, 0xE38, 0xB6) == 0) {
+        if (this->actor.bgCheckFlags & 0x20) {
+            this->runYaw = Actor_WorldYawTowardPoint(&this->actor, &this->actor.home.pos);
+        } else if (this->actor.bgCheckFlags & 8) {
+            this->runYaw = this->actor.wallYaw;
+        } else if (this->animFlagAndTimer == 0) {
+            s16 toHome = Actor_WorldYawTowardPoint(&this->actor, &this->actor.home.pos);
+            s16 diff = toHome - this->actor.yawTowardsPlayer;
+
+            if (ABS(diff) >= 0x2001) {
+                this->runYaw = toHome;
+            } else {
+                this->runYaw = (s16)((((0.0f <= (f32)diff) ? 1.0f : -1.0f) * -8192.0f) +
+                                     (f32)this->actor.yawTowardsPlayer);
+            }
+        } else {
+            this->runYaw = (s16)(this->actor.yawTowardsPlayer + 0x8000);
+        }
+    }
+    this->actor.shape.rot.y = this->actor.world.rot.y + 0x8000;
+    if (Actor_ProcessTalkRequest(&this->actor, play)) {
+        Animation_MorphToLoop(&this->skelAnime, &gHintNutsTalkAnim, -5.0f);
+        this->actor.speedXZ = 0.0f;
+        this->actionFunc = MlHoleScrub_Talk;
+    } else {
+        // ML compares the distance home with -20, so the vanilla "back home, burrow" branch never runs.
+        MlHoleScrub_CheckProximity(this, play);
+    }
+}
+
+static void MlHoleScrub_Talk(MlHoleScrub* this, PlayState* play) {
+    SkelAnime_Update(&this->skelAnime);
+    Math_SmoothStepToS(&this->actor.shape.rot.y, this->actor.yawTowardsPlayer, 0x3, 0x400, 0x100);
+    if (Message_GetState(&play->msgCtx) == TEXT_STATE_NONE) { // ML: once the text has closed
+        MlHoleScrub_SetupLeave(this);
+    }
+}
+
+static void MlHoleScrub_Leave(MlHoleScrub* this, PlayState* play) {
+    s16 yaw;
+
+    SkelAnime_Update(&this->skelAnime);
+    if (this->animFlagAndTimer != 0) {
+        this->animFlagAndTimer--;
+    }
+    if (this->actor.bgCheckFlags & 8) {
+        yaw = this->actor.wallYaw;
+    } else {
+        yaw = this->actor.yawTowardsPlayer - Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) - 0x8000;
+        if (ABS(yaw) >= 0x4001) {
+            yaw = Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) + 0x8000;
+        } else {
+            yaw = Camera_GetCamDirYaw(GET_ACTIVE_CAM(play)) - (yaw >> 1) + 0x8000;
+        }
+    }
+    Math_ScaledStepToS(&this->actor.shape.rot.y, yaw, 0x800);
+    this->actor.world.rot.y = this->actor.shape.rot.y;
+    // ML: back to standing at once instead of running off and despawning.
+    this->actionFunc = MlHoleScrub_Stand;
+    Message_CloseTextbox(play);
+    if (this->actor.child != NULL) {
+        Actor_ChangeCategory(play, &play->actorCtx, this->actor.child, ACTORCAT_PROP);
+    }
+}
+
+static void MlHoleScrub_ColliderCheck(MlHoleScrub* this, PlayState* play) {
+    if (this->collider.base.acFlags & AC_HIT) {
+        this->collider.base.acFlags &= ~AC_HIT;
+        Actor_SetDropFlag(&this->actor, &this->collider.info, 1);
+        if (this->collider.base.ac->id != ACTOR_EN_NUTSBALL) {
+            MlHoleScrub_SetupBurrow(this);
+            return;
+        }
+    } else if (play->actorCtx.unk_02 == 0) {
+        return;
+    }
+    // Hit by a Deku nut or an explosion: vanilla's HitByScrubProjectile, minus the enemy-only puzzle.
+    Animation_MorphToPlayOnce(&this->skelAnime, &gHintNutsUnburrowAnim, -3.0f);
+    this->collider.dim.height = 37;
+    Audio_PlayActorSound2(&this->actor, NA_SE_EN_NUTS_DAMAGE);
+    this->collider.base.acFlags &= ~AC_ON;
+    this->actionFunc = MlHoleScrub_BeginRun;
+}
+
+void MlHoleScrub_Update(Actor* thisx, PlayState* play) {
+    MlHoleScrub* this = (MlHoleScrub*)thisx;
+    Actor* enemy;
+
+    MlHoleScrub_ColliderCheck(this, play);
+    this->actionFunc(this, play);
+    // ML drops Actor_MoveXZGravity: the scrub only ever teleports.
+    Actor_UpdateBgCheckInfo(play, &this->actor, 20.0f, this->collider.dim.radius, this->collider.dim.height, 0x1D);
+    Collider_UpdateCylinder(&this->actor, &this->collider);
+    CollisionCheck_SetAC(play, &play->colChkCtx, &this->collider.base); // ML: unconditionally
+    CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
+    if (this->actionFunc == MlHoleScrub_Wait) {
+        Actor_SetFocus(&this->actor, this->skelAnime.curFrame);
+    } else if (this->actionFunc == MlHoleScrub_Burrow) {
+        Actor_SetFocus(&this->actor,
+                       20.0f - ((this->skelAnime.curFrame * 20.0f) / Animation_GetLastFrame(&gHintNutsBurrowAnim)));
+    } else {
+        Actor_SetFocus(&this->actor, 20.0f);
+    }
+    for (enemy = play->actorCtx.actorLists[ACTORCAT_ENEMY].head; enemy != NULL; enemy = enemy->next) {
+        if (enemy->params != 10) {
+            enemy->world.pos.y = -960.0f;
+        }
+    }
+}
+
+void MlHoleScrub_Draw(Actor* thisx, PlayState* play) {
+    MlHoleScrub* this = (MlHoleScrub*)thisx;
+
+    SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, NULL, NULL, this);
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_HoleScrub/z_ml_holescrub.h b/soh/src/overlays/actors/ovl_Ml_HoleScrub/z_ml_holescrub.h
