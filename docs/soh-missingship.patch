+static void EnMag_DrawInnerMl(Actor* thisx, PlayState* play, Gfx** gfxP) {
+    static void* effectMaskTextures[] = {
+        gMlTitleEffectMask00Tex, gMlTitleEffectMask01Tex, gMlTitleEffectMask02Tex,
