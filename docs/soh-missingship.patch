+/*
+ * File: z_ml_eventspawner.c
+ * Overlay: ovl_Ml_EventSpawner
+ * Description: The Missing Link - scripted-event spawner (ML's rewrite of En_Fz, slot 0x121)
+ *
+ * ML turned the Freezard slot (ML dma 259, text 0xBA0) into an event helper whose params pick a mode:
+ *   2, 4, 5, 6  only when Link arrives by ML entrance 0x138 or 0x058 (remapped: Gerudo Valley slot spawn 4 and
+ *               Lon Lon Ranch slot spawn 0), spawn Bg_Umajump / En_Ma1 / a Deku Baba / a Tektite in place, then leave;
+ *   7           stop the running timer (Deep Woods' grotto arena ends the chase);
+ *   0, 1, 3     a creature on object 0xA0 and its chase / cutscene logic -- NOT PORTED YET (they leave at once,
+ *               where SoH would otherwise spawn a vanilla Freezard).
+ * Mode 4 spawns ML's rewritten En_Ma1, which is not ported either, so it is held back too.
+ */
+
+#include "z_ml_eventspawner.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlEventSpawner_Init(Actor* thisx, PlayState* play);
+void MlEventSpawner_Destroy(Actor* thisx, PlayState* play);
+void MlEventSpawner_Update(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_EventSpawner_InitVars = {
+    ACTOR_EN_FZ,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP,
+    sizeof(MlEventSpawner),
+    (ActorFunc)MlEventSpawner_Init,
+    (ActorFunc)MlEventSpawner_Destroy,
+    (ActorFunc)MlEventSpawner_Update,
+    NULL,
+    NULL,
+};
+
+static void MlEventSpawner_SpawnHere(Actor* thisx, PlayState* play, s16 actorId, s16 params) {
+    Actor_Spawn(&play->actorCtx, play, actorId, thisx->world.pos.x, thisx->world.pos.y, thisx->world.pos.z,
+                thisx->shape.rot.x, thisx->shape.rot.y, thisx->shape.rot.z, params);
+}
+
+void MlEventSpawner_Init(Actor* thisx, PlayState* play) {
+    bool eventEntrance = (gSaveContext.entranceIndex == ENTR_GERUDO_VALLEY_OUTSIDE_TENT) ||
+                         (gSaveContext.entranceIndex == ENTR_LON_LON_RANCH_ENTRANCE);
+
+    switch ((u16)thisx->params) {
+        case 2:
+            if (eventEntrance) {
+                MlEventSpawner_SpawnHere(thisx, play, ACTOR_BG_UMAJUMP, 0);
+            }
+            break;
+        case 5:
+            if (eventEntrance) {
+                MlEventSpawner_SpawnHere(thisx, play, ACTOR_EN_DEKUBABA, 1);
+            }
+            break;
+        case 6:
+            if (eventEntrance) {
+                MlEventSpawner_SpawnHere(thisx, play, ACTOR_EN_TITE, -1);
+            }
+            break;
+        case 7:
+            gSaveContext.timerState = TIMER_STATE_STOP;
+            break;
+        default: // 0, 1, 3 (creature / chase) and 4 (ML's En_Ma1): not ported yet
+            break;
+    }
+    Actor_Kill(thisx);
+}
+
+void MlEventSpawner_Destroy(Actor* thisx, PlayState* play) {
+}
+
+void MlEventSpawner_Update(Actor* thisx, PlayState* play) {
+}
