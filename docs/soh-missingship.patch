@@ -0,0 +1,54 @@
+/*
+ * File: z_ml_roomclearswitch.c
+ * Overlay: ovl_Ml_RoomClearSwitch
+ * Description: The Missing Link - holds switch 0x25 while the room still has enemies (ML custom actor, slot 0x01A)
+ *
+ * Source overlay: ML dma 164, text 0x260 (ML's own code in vanilla's unset slot 0x1A). Placed once, in HAKAdan
+ * room 20. After 34 frames it sets switch 0x25 every frame until the room is cleared, then unsets it and removes
+ * itself. It removes itself at once if the room was already cleared. Nothing is drawn.
+ */
+
+#include "z_ml_roomclearswitch.h"
+
+#define FLAGS (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+#define ML_ROOM_CLEAR_SWITCH 0x25
+
+void MlRoomClearSwitch_Init(Actor* thisx, PlayState* play);
+void MlRoomClearSwitch_Destroy(Actor* thisx, PlayState* play);
+void MlRoomClearSwitch_Update(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_RoomClearSwitch_InitVars = {
+    ACTOR_ML_ROOMCLEARSWITCH,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP,
+    sizeof(MlRoomClearSwitch),
+    (ActorFunc)MlRoomClearSwitch_Init,
+    (ActorFunc)MlRoomClearSwitch_Destroy,
+    (ActorFunc)MlRoomClearSwitch_Update,
+    NULL,
+    NULL,
+};
+
+void MlRoomClearSwitch_Init(Actor* thisx, PlayState* play) {
+    if (Flags_GetClear(play, thisx->room)) {
+        Actor_Kill(thisx);
+    }
+}
+
+void MlRoomClearSwitch_Destroy(Actor* thisx, PlayState* play) {
+}
+
+void MlRoomClearSwitch_Update(Actor* thisx, PlayState* play) {
+    MlRoomClearSwitch* this = (MlRoomClearSwitch*)thisx;
+
+    if (this->timer < 34) {
+        this->timer++;
+    } else if (Flags_GetClear(play, thisx->room)) {
+        Flags_UnsetSwitch(play, ML_ROOM_CLEAR_SWITCH);
+        Actor_Kill(thisx);
+    } else {
+        Flags_SetSwitch(play, ML_ROOM_CLEAR_SWITCH);
+    }
+}
