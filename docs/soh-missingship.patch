+// MissingShip: ML draws area titles itself (TitleCard_Draw's call in Actor_DrawAll hooked to 0x806037F0) for every
+// scene but slot 0x18: a 160x8 IA16 ribbon from its custom code, stretched across the screen at y 66-86 and tinted
+// per scene, under the white title texture at (88, 68). Both fade with the card's alpha.
+static u8 sMlTitleBannerTex[] ALIGNED8 = {
+#include "ml_titlecard_banner.inc"
+};
+
+static void MlTitleCard_Draw(PlayState* play, TitleCardContext* titleCtx) {
+    u8 r = 0;
+    u8 g = 255;
+    u8 b = 138;
+    s32 x = 88;
+    s32 y = 68;
+
+    switch (play->sceneNum) {
+        case 0x55: // Kokiri Forest's slot
+        case 0x5B: // Deep Woods
+            r = 255;
+            g = 252;
+            b = 0;
+            break;
+        case 0x03:
+        case 0x2B:
+        case 0x32:
+        case 0x52:
+            r = 255;
+            g = 0;
+            b = 0;
+            break;
+    }
+
+    OPEN_DISPS(play->state.gfxCtx);
+
+    OVERLAY_DISP = Gfx_SetupDL_52NoCD(OVERLAY_DISP);
+    gDPSetCombineLERP(OVERLAY_DISP++, PRIMITIVE, ENVIRONMENT, TEXEL0, ENVIRONMENT, TEXEL0, 0, PRIMITIVE, 0, PRIMITIVE,
+                      ENVIRONMENT, TEXEL0, ENVIRONMENT, TEXEL0, 0, PRIMITIVE, 0);
+    gDPSetPrimColor(OVERLAY_DISP++, 0, 0, r, g, b, (u8)titleCtx->alpha);
+    gDPSetEnvColor(OVERLAY_DISP++, 0, 0, 0, 255);
+    gDPLoadTextureBlock(OVERLAY_DISP++, sMlTitleBannerTex, G_IM_FMT_IA, G_IM_SIZ_16b, 160, 8, 0,
+                        G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD,
+                        G_TX_NOLOD);
+    gSPTextureRectangle(OVERLAY_DISP++, 0 << 2, 66 << 2, 320 << 2, 86 << 2, G_TX_RENDERTILE, 0, 0, 1 << 9, 0x199);
+
+    gDPPipeSync(OVERLAY_DISP++);
+    gDPSetPrimColor(OVERLAY_DISP++, 0, 0, 255, 255, 255, (u8)titleCtx->alpha);
+    gDPLoadTextureBlock(OVERLAY_DISP++, (uintptr_t)titleCtx->texture, G_IM_FMT_IA, G_IM_SIZ_8b, titleCtx->width,
+                        titleCtx->height, 0, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK,
+                        G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+    gSPTextureRectangle(OVERLAY_DISP++, x << 2, y << 2, (x + titleCtx->width) << 2, (y + titleCtx->height) << 2,
+                        G_TX_RENDERTILE, 0, 0, 1 << 10, 1 << 10);
+
+    CLOSE_DISPS(play->state.gfxCtx);
+}
