diff --git a/soh/src/overlays/actors/ovl_Ml_Fishpond/z_ml_fishpond.c b/soh/src/overlays/actors/ovl_Ml_Fishpond/z_ml_fishpond.c
new file mode 100644
index 0000000000000000000000000000000000000000..98835b6cc4ef73cb1a3dea44a7cdb09f04ca4687
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_Fishpond/z_ml_fishpond.c
@@ -0,0 +1,87 @@
+/*
+ * File: z_ml_fishpond.c
+ * Overlay: ovl_Ml_Fishpond
+ * Description: The Missing Link - fishing pond scenery (ML actor 0x003)
+ *
+ * Ported from The Missing Link's own overlay, which occupies a slot vanilla leaves as
+ * DEFINE_ACTOR_UNSET(ACTOR_UNSET_3). ML fills all eight unset slots that way; converting the slot
+ * in place keeps every actor id byte-identical, so no scene data has to be rewritten.
+ *
+ * Source overlay: ML dma 104, 496 bytes (text 320 / data 16 / rodata 64), vram 0x80800000.
+ * Placed 13x in turibori_r0 (fishing pond), params selecting one of four display lists.
+ * The display lists live in ML's replacement for object slot 0x40 (OBJECT_JJ in vanilla), shipped
+ * as objects/object_ml_fishpond/* in MissingLink_Scenes.o2r.
+ */
+
+#include "z_ml_fishpond.h"
+#include "assets/ml_assets.h"
+#include "code/ml_entrance_map.h"
+#include "overlays/actors/ovl_En_Elf/z_en_elf.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlFishpond_Init(Actor* thisx, PlayState* play);
+void MlFishpond_Destroy(Actor* thisx, PlayState* play);
+void MlFishpond_Update(Actor* thisx, PlayState* play);
+void MlFishpond_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_Fishpond_InitVars = {
+    ACTOR_ML_FISHPOND,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_JJ,
+    sizeof(MlFishpond),
+    (ActorFunc)MlFishpond_Init,
+    (ActorFunc)MlFishpond_Destroy,
+    (ActorFunc)MlFishpond_Update,
+    (ActorFunc)MlFishpond_Draw,
+    NULL,
+};
+
+// ML stores these as four segment-6 pointers in the overlay's .data section:
+// 0x06000978, 0x06002878, 0x06003068, 0x06003728.
+static const char* sDLists[] = {
+    gMlFishpond0DL,
+    gMlFishpond1DL,
+    gMlFishpond2DL,
+    gMlFishpond3DL,
+};
+
+void MlFishpond_Init(Actor* thisx, PlayState* play) {
+    MlFishpond* this = (MlFishpond*)thisx;
+
+    thisx->uncullZoneForward = 6000.0f;
+    thisx->uncullZoneScale = 2000.0f;
+    thisx->uncullZoneDownward = 4000.0f;
+    Actor_SetScale(thisx, 0.1f);
+
+    this->dlIndex = (u8)thisx->params;
+    // ML indexes a four-entry table with the raw params byte and does not range check it. Every
+    // placement in turibori_r0 uses 0-3, but clamp rather than inherit an out-of-bounds read.
+    if (this->dlIndex >= ARRAY_COUNT(sDLists)) {
+        this->dlIndex = 0;
+    }
+
+    // The params==0 instance spawns a companion chosen by the entrance Link arrived from: after a blue warp (ML 0x41C)
+    // a Navi-type Ml_Elf at the origin; after the pond intro cutscene (ML 0x420, via ML's patched destination 56)
+    // Ml_EventSpawner mode 3, Epona walking off with Link.
+    if (thisx->params == 0) {
+        if (gSaveContext.entranceIndex == MlEntrance_ToSoh(0x41C)) {
+            Actor_Spawn(&play->actorCtx, play, ACTOR_ML_ELF, 0.0f, 0.0f, 0.0f, 0, 0, 0, FAIRY_NAVI);
+        } else if (gSaveContext.entranceIndex == MlEntrance_ToSoh(0x420)) {
+            Actor_Spawn(&play->actorCtx, play, ACTOR_EN_FZ, 691.0f, 2000.0f, -558.0f, 0, -8640, 0, 3);
+        }
+    }
+}
+
+void MlFishpond_Destroy(Actor* thisx, PlayState* play) {
+}
+
+void MlFishpond_Update(Actor* thisx, PlayState* play) {
+}
+
+void MlFishpond_Draw(Actor* thisx, PlayState* play) {
+    MlFishpond* this = (MlFishpond*)thisx;
+
+    Gfx_DrawDListOpa(play, (Gfx*)sDLists[this->dlIndex]);
+}
