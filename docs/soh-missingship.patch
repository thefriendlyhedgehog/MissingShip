+static CollisionPoly sMlTreeBridgePolys[] = {
+    { 0x0000, { { 0x0000, 0x0001, 0x0002 } }, { 25939, 13677, -14620 }, -27 },
+    { 0x0000, { { 0x0003, 0x0000, 0x0002 } }, { 1538, 14285, 29449 }, -33 },
+    { 0x0000, { { 0x0004, 0x0003, 0x0002 } }, { -22745, 15422, 17847 }, -2 },
