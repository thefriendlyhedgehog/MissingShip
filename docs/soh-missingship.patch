+// MissingShip (MS-102): ML rewrote this soft-soil spot. Bugs dropped on it for 60 frames still trigger it, but it
+// brings up a Piece of Heart (collectible flag 0x0C) instead of a Gold Skulltula: the heart rises 40 units out of the
+// soil, 10 a frame, then settles back to the soil.
+static void ObjMakekinsuta_MlRaiseHeartPiece(ObjMakekinsuta* this, PlayState* play) {
+    Actor* heartPiece = play->actorCtx.actorLists[ACTORCAT_MISC].head;
+
+    // ML keeps moving the pointer even if Link grabbed the heart mid-rise (harmless stale memory on N64); here, stop
+    // once it is gone.
+    while ((heartPiece != NULL) && (heartPiece != this->heartPiece)) {
+        heartPiece = heartPiece->next;
+    }
+    if (heartPiece == NULL) {
+        this->actionFunc = ObjMakekinsuta_DoNothing;
+        return;
+    }
+
+    if (!this->risen) {
+        if (heartPiece->world.pos.y < this->actor.world.pos.y + 40.0f) {
+            heartPiece->world.pos.y += 10.0f;
+        } else {
+            this->risen = true;
+        }
+    } else if (this->actor.world.pos.y < heartPiece->world.pos.y) {
+        heartPiece->world.pos.y -= 10.0f;
+    } else {
+        heartPiece->world.pos.y = this->actor.world.pos.y;
+        this->actionFunc = ObjMakekinsuta_DoNothing;
+    }
+}
