@@ -0,0 +1,16 @@
+#ifndef Z_ML_ELEVATOR_H
+#define Z_ML_ELEVATOR_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+// ML's layout (size 0x178), for reference against its overlay; SoH's own offsets differ.
+typedef struct MlElevator {
+    /* 0x000 */ DynaPolyActor dyna;
+    /* 0x168 */ f32 topY;
+    /* 0x16C */ f32 bottomY;
+    /* 0x170 */ s32 state; // 0 idle, 1 rising, -1 lowering, 2 arrived (until Link steps off)
+    /* 0x174 */ s32 dir;   // direction of the next trip: 0 before the first, then 1 (up) or -1 (down)
+} MlElevator;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_ElevatorSpawner/z_ml_elevatorspawner.c b/soh/src/overlays/actors/ovl_Ml_ElevatorSpawner/z_ml_elevatorspawner.c
new file mode 100644
index 0000000000000000000000000000000000000000..fd75e24220469bdfe4d58929af0a54432e97509c
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_ElevatorSpawner/z_ml_elevatorspawner.c
@@ -0,0 +1,54 @@
+/*
+ * File: z_ml_elevatorspawner.c
+ * Overlay: ovl_Ml_ElevatorSpawner
+ * Description: The Missing Link - spawns HAKAdan's tall elevator once (ML's rewrite of Bg_Hidan_Dalm, slot 0x040)
+ *
+ * Source overlay: ML dma 184, text 0x100. Placed once, in HAKAdan room 19. Init looks for an Ml_Elevator among the
+ * BG actors; if there is none it spawns the tall one (params 1) at (-1154, -1685, -627), yaw 0x42D8, with room -1 so
+ * it survives room changes. Either way it then removes itself.
+ */
+
+#include "z_ml_elevatorspawner.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlElevatorSpawner_Init(Actor* thisx, PlayState* play);
+void MlElevatorSpawner_Destroy(Actor* thisx, PlayState* play);
+void MlElevatorSpawner_Update(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_ElevatorSpawner_InitVars = {
+    ACTOR_BG_HIDAN_DALM,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP,
+    sizeof(MlElevatorSpawner),
+    (ActorFunc)MlElevatorSpawner_Init,
+    (ActorFunc)MlElevatorSpawner_Destroy,
+    (ActorFunc)MlElevatorSpawner_Update,
+    NULL,
+    NULL,
+};
+
+void MlElevatorSpawner_Init(Actor* thisx, PlayState* play) {
+    MlElevatorSpawner* this = (MlElevatorSpawner*)thisx;
+    Actor* actor;
+
+    for (actor = play->actorCtx.actorLists[ACTORCAT_BG].head; actor != NULL; actor = actor->next) {
+        if (actor->id == ACTOR_EN_KAKASI) {
+            this->found = true;
+        }
+    }
+    if (!this->found) {
+        actor = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_KAKASI, -1154.0f, -1685.0f, -627.0f, 0, 0x42D8, 0, 1);
+        if (actor != NULL) { // ML doesn't check
+            actor->room = -1;
+        }
+    }
+    Actor_Kill(thisx);
+}
+
+void MlElevatorSpawner_Destroy(Actor* thisx, PlayState* play) {
+}
+
+void MlElevatorSpawner_Update(Actor* thisx, PlayState* play) {
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_ElevatorSpawner/z_ml_elevatorspawner.h b/soh/src/overlays/actors/ovl_Ml_ElevatorSpawner/z_ml_elevatorspawner.h
