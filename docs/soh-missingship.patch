diff --git a/soh/src/overlays/actors/ovl_Ml_HakaLift/z_ml_hakalift.c b/soh/src/overlays/actors/ovl_Ml_HakaLift/z_ml_hakalift.c
new file mode 100644
index 0000000000000000000000000000000000000000..cace811bfecdc9fa5f9859aae7cf3d7a19d7d067
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_HakaLift/z_ml_hakalift.c
@@ -0,0 +1,103 @@
+/*
+ * File: z_ml_hakalift.c
+ * Overlay: ovl_Ml_HakaLift
+ * Description: The Missing Link - HAKAdan's room 2 lift (ML's rewrite of Bg_Mori_Elevator, slot 0x087)
+ *
+ * Source overlay: ML dma 206, text 0x280, on ML's own object 0x72 (dma 22). Standing on it sends it 675 units to
+ * the other end at 17 per frame; it waits there until Link steps off, and it doesn't come back by itself. It
+ * starts at the top when Link loads in above it. While Link stands on it the camera uses setting 9.
+ */
+
+#include "z_ml_hakalift.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlHakaLift_Init(Actor* thisx, PlayState* play);
+void MlHakaLift_Destroy(Actor* thisx, PlayState* play);
+void MlHakaLift_Update(Actor* thisx, PlayState* play);
+void MlHakaLift_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_HakaLift_InitVars = {
+    ACTOR_BG_MORI_ELEVATOR,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_MORI_OBJECTS,
+    sizeof(MlHakaLift),
+    (ActorFunc)MlHakaLift_Init,
+    (ActorFunc)MlHakaLift_Destroy,
+    (ActorFunc)MlHakaLift_Update,
+    (ActorFunc)MlHakaLift_Draw,
+    NULL,
+};
+
+static InitChainEntry sInitChain[] = {
+    ICHAIN_F32(uncullZoneForward, 2000, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneScale, 600, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneDownward, 2000, ICHAIN_STOP),
+};
+
+void MlHakaLift_Init(Actor* thisx, PlayState* play) {
+    MlHakaLift* this = (MlHakaLift*)thisx;
+    CollisionHeader* colHeader = NULL;
+
+    Actor_SetScale(thisx, 0.1f);
+    Actor_ProcessInitChain(thisx, sInitChain);
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    CollisionHeader_GetVirtual(gMlHakaLiftCol, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
+    this->bottomY = thisx->world.pos.y;
+    this->topY = thisx->world.pos.y + 675.0f;
+    this->state = 0;
+    this->dir = 0;
+    if (this->topY - 50.0f < GET_PLAYER(play)->actor.world.pos.y) {
+        thisx->world.pos.y = this->topY;
+        this->dir = -1;
+    }
+}
+
+void MlHakaLift_Destroy(Actor* thisx, PlayState* play) {
+    MlHakaLift* this = (MlHakaLift*)thisx;
+
+    DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+}
+
+void MlHakaLift_Update(Actor* thisx, PlayState* play) {
+    MlHakaLift* this = (MlHakaLift*)thisx;
+    s32 onTop = DynaPolyActor_IsPlayerOnTop(&this->dyna);
+
+    if (onTop) {
+        if (this->state == 0) {
+            this->state = (this->dir == 0) ? 1 : this->dir;
+        }
+    } else if (this->state == 2) {
+        this->state = 0;
+        return;
+    }
+
+    if (this->state == 1) {
+        thisx->world.pos.y += 17.0f;
+        Audio_PlayActorSound2(thisx, NA_SE_EV_ELEVATOR_MOVE - SFX_FLAG);
+        if (this->topY <= thisx->world.pos.y) {
+            this->dir = -1;
+            thisx->world.pos.y = this->topY;
+            this->state = 2;
+        }
+    } else if (this->state == -1) {
+        thisx->world.pos.y -= 17.0f;
+        Audio_PlayActorSound2(thisx, NA_SE_EV_ELEVATOR_MOVE - SFX_FLAG);
+        if (thisx->world.pos.y <= this->bottomY) {
+            thisx->world.pos.y = this->bottomY;
+            this->dir = 1;
+            this->state = 2;
+        }
+    }
+
+    if (onTop) {
+        Camera_ChangeDataIdx(&play->mainCamera, 9);
+    }
+}
+
+void MlHakaLift_Draw(Actor* thisx, PlayState* play) {
+    Gfx_DrawDListOpa(play, (Gfx*)gMlHakaLiftDL);
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_HakaLift/z_ml_hakalift.h b/soh/src/overlays/actors/ovl_Ml_HakaLift/z_ml_hakalift.h
