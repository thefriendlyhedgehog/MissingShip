--- /dev/null
+++ b/soh/src/code/ml_state.c
@@ -0,0 +1,36 @@
+#include "ml_state.h"
+
+// MissingShip: ML's per-frame bookkeeping from its custom code.
+//
+// 0x80600E80 (called from Player_Update, player +0x17E5C) keys the current scene and room as
+// sceneNum | (roomNum << 4); when the key changes it restarts a frame counter, which it caps at 169. The same counter
+// sizes the Magic Hourglass rewind buffer (not ported yet).
+// 0x80602C80 (replacing the Math_Vec3f_Copy that applies a wall push-out in Actor_UpdateBgCheckInfo) skips the push
+// while that counter is below 2, and, in Deep Woods, for the next gMlWallSkip calls after its looping corridor
+// teleports Link (set to 2 by the teleport, 0x80602188).
+
+u16 gMlRoomFrames = 0;
+s32 gMlWallSkip = 0;
+static u16 sMlRoomKey = 0;
+
+void MlState_PlayerUpdate(PlayState* play) {
+    u16 key = play->sceneNum | (play->roomCtx.curRoom.num << 4);
+
+    if (key != sMlRoomKey) {
+        sMlRoomKey = key;
+        gMlRoomFrames = 0;
+    } else if (gMlRoomFrames < 169) {
+        gMlRoomFrames++;
+    }
+}
+
+s32 MlState_SkipWallPush(PlayState* play) {
+    if (gMlRoomFrames < 2) {
+        return true;
+    }
+    if (gMlWallSkip != 0) {
+        gMlWallSkip--;
+        return play->sceneNum == SCENE_LOST_WOODS; // ML's Deep Woods (slot 0x5B)
+    }
+    return false;
+}
