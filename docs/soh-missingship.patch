+} MlSkullKid;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c b/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c
new file mode 100644
index 0000000..92ffb7c
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_SongBlock/z_ml_songblock.c
@@ -0,0 +1,96 @@
+/*
+ * File: z_ml_songblock.c
+ * Overlay: ovl_Ml_SongBlock
+ * Description: The Missing Link - the block sealing the way to Saria's house until a song is played
+ *
+ * ML rewrote Obj_Timeblock (slot 0x1D1) wholesale: 608 bytes of text against vanilla's 2864, no Song of Time
+ * logic at all. It draws and collides from ML's refilled object_ouke_haka (0x18F) and, on Init, places a
+ * vanilla En_Okarina_Tag (params 0x1C0C: switch 0x0C) at fixed Kokiri Forest coordinates. Playing the song
+ * there sets switch 0x0C; the block then shows a Magic_Wind sparkle and, after 30 frames, sinks 2 units per
+ * frame for 150 frames under a short cutscene before removing itself.
+ */
+
+#include "z_ml_songblock.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+#define ML_SONGBLOCK_SWITCH 0x0C
+
+void MlSongBlock_Init(Actor* thisx, PlayState* play);
+void MlSongBlock_Destroy(Actor* thisx, PlayState* play);
+void MlSongBlock_Update(Actor* thisx, PlayState* play);
+void MlSongBlock_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_SongBlock_InitVars = {
+    ACTOR_OBJ_TIMEBLOCK,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_OUKE_HAKA,
+    sizeof(MlSongBlock),
+    (ActorFunc)MlSongBlock_Init,
+    (ActorFunc)MlSongBlock_Destroy,
+    (ActorFunc)MlSongBlock_Update,
+    (ActorFunc)MlSongBlock_Draw,
+    NULL,
+};
+
+void MlSongBlock_Init(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+    CollisionHeader* colHeader = NULL;
+
+    if (Flags_GetSwitch(play, ML_SONGBLOCK_SWITCH)) {
+        this->killedAtInit = true;
+        Actor_Kill(thisx);
+        return;
+    }
+
+    Actor_SetScale(thisx, 1.0f);
+    thisx->uncullZoneForward = 2000.0f;
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    CollisionHeader_GetVirtual(gMlSongBlockCol, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
+
+    // ML hardcodes where the song must be played.
+    Actor_Spawn(&play->actorCtx, play, ACTOR_EN_OKARINA_TAG, 1128.0f, 268.0f, -1370.0f, 0, thisx->world.rot.y, 0,
+                0x1C0C);
+}
+
+void MlSongBlock_Destroy(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+
+    if (!this->killedAtInit) {
+        DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+    }
+}
+
+void MlSongBlock_Update(Actor* thisx, PlayState* play) {
+    MlSongBlock* this = (MlSongBlock*)thisx;
+
+    if (this->state == 1) {
+        this->sparkle = Actor_Spawn(&play->actorCtx, play, ACTOR_MAGIC_WIND, thisx->world.pos.x, thisx->world.pos.y,
+                                    thisx->world.pos.z, 0, 0, 0, 0);
+        this->state = 2;
+    } else if (this->state == 2) {
+        Camera_ChangeDataIdx(&play->mainCamera, 3);
+        func_80064520(play, &play->csCtx);
+        this->timer++;
+        if (this->timer >= 31) {
+            thisx->world.pos.y -= 2.0f;
+            Player_PlaySfx(thisx, 0x208F);
+            if (this->timer >= 181) {
+                func_80064534(play, &play->csCtx);
+                if (this->sparkle != NULL) {
+                    Actor_Kill(this->sparkle);
+                }
+                Actor_Kill(thisx);
+            }
+        }
+    } else if (Flags_GetSwitch(play, ML_SONGBLOCK_SWITCH)) {
+        this->state = 1;
+    }
+}
+
+void MlSongBlock_Draw(Actor* thisx, PlayState* play) {
+    Gfx_DrawDListOpa(play, (Gfx*)gMlSongBlockDL);
+}
