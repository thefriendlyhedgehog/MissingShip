diff --git a/soh/src/overlays/actors/ovl_Ml_TreeBridge/z_ml_treebridge.c b/soh/src/overlays/actors/ovl_Ml_TreeBridge/z_ml_treebridge.c
new file mode 100644
index 0000000..31ce8de
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_TreeBridge/z_ml_treebridge.c
@@ -0,0 +1,142 @@
+/*
+ * File: z_ml_treebridge.c
+ * Overlay: ovl_Ml_TreeBridge
+ * Description: The Missing Link - the tree Mido says to cut down (ML actor 0x005)
+ *
+ * Ported from ML's overlay in vanilla's unused slot 0x005 (ML dma 105, text 0x470). Placed in Kokiri Forest
+ * (spot04) with params 0x0406: low byte = switch flag, high byte = camera data index for the fall. A Blade
+ * Beam (ML's actor 0x57) within 45 units sets the switch; the tree then catches fire (En_Light type 5),
+ * topples over to 90 degrees with two bounces and becomes the bridge Mido's line 0x1046 asks for. Its model
+ * is appended to object_wood02 (the rest of that object is vanilla), and its collision lives in the overlay
+ * itself, so it is carried here as C data (z_ml_treebridge_col.inc).
+ */
+
+#include "z_ml_treebridge.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS (ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+void MlTreeBridge_Init(Actor* thisx, PlayState* play);
+void MlTreeBridge_Destroy(Actor* thisx, PlayState* play);
+void MlTreeBridge_Update(Actor* thisx, PlayState* play);
+void MlTreeBridge_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_TreeBridge_InitVars = {
+    ACTOR_ML_TREEBRIDGE,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_WOOD02,
+    sizeof(MlTreeBridge),
+    (ActorFunc)MlTreeBridge_Init,
+    (ActorFunc)MlTreeBridge_Destroy,
+    (ActorFunc)MlTreeBridge_Update,
+    (ActorFunc)MlTreeBridge_Draw,
+    NULL,
+};
+
+#include "z_ml_treebridge_col.inc"
+
+void MlTreeBridge_Init(Actor* thisx, PlayState* play) {
+    MlTreeBridge* this = (MlTreeBridge*)thisx;
+    s32 isDown = Flags_GetSwitch(play, thisx->params & 0xFF);
+
+    // Once the Soul-Charged sword is owned, ML also changes Kokiri Forest's weather here.
+    if (gSaveContext.inventory.ammo[SLOT_SLINGSHOT] == 40) {
+        Actor_Spawn(&play->actorCtx, play, ACTOR_EN_WEATHER_TAG, 0.0f, 0.0f, 0.0f, 0, 0, 0, 0x7607);
+    }
+
+    Actor_SetScale(thisx, 1.0f);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, &sMlTreeBridgeCol);
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+
+    if (isDown) {
+        this->alreadyDown = true;
+        thisx->shape.rot.x = 0x4000;
+    }
+}
+
+void MlTreeBridge_Destroy(Actor* thisx, PlayState* play) {
+    MlTreeBridge* this = (MlTreeBridge*)thisx;
+
+    DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+}
+
+void MlTreeBridge_Update(Actor* thisx, PlayState* play) {
+    MlTreeBridge* this = (MlTreeBridge*)thisx;
+    s32 switchFlag = thisx->params & 0xFF;
+    s32 isDown = Flags_GetSwitch(play, switchFlag);
+    // ML looks for any actor 0x57 in the item-action category: the beam, but also a spin being charged here.
+    Actor* beam = Actor_FindNearby(play, thisx, ACTOR_EN_M_THUNDER, ACTORCAT_ITEMACTION, 45.0f);
+
+    if (this->alreadyDown) {
+        return;
+    }
+    if (beam != NULL && !isDown) {
+        Flags_SetSwitch(play, switchFlag);
+        return;
+    }
+    if (!isDown || this->finished) {
+        return;
+    }
+
+    Camera_ChangeDataIdx(&play->mainCamera, (u16)thisx->params >> 8);
+    this->timer++;
+
+    switch (this->state) {
+        case 0:
+            func_80064520(play, &play->csCtx);
+            this->state = 1;
+            break;
+        case 1:
+            this->light = Actor_Spawn(&play->actorCtx, play, ACTOR_EN_LIGHT, thisx->world.pos.x, thisx->world.pos.y,
+                                      thisx->world.pos.z, 0, 0, 0, 5);
+            this->state = 2;
+            break;
+        case 2:
+            Audio_PlayActorSound2(thisx, 0x2855);
+            this->fallStep = 200.0f;
+            this->state = 3;
+            break;
+        case 3:
+            if (this->light != NULL) {
+                this->light->scale.x -= 0.00015f;
+                this->light->scale.y -= 0.00015f;
+                this->light->scale.z -= 0.00015f;
+            }
+            Math_ScaledStepToS(&thisx->shape.rot.x, 0x4000, (s16)this->fallStep);
+            if (this->timer >= 21) {
+                this->fallStep += 40.0f;
+            }
+            if (thisx->shape.rot.x == 0x4000) {
+                this->state = 4;
+            }
+            break;
+        case 4: // first bounce
+            Math_ScaledStepToS(&thisx->shape.rot.x, 0x3D00, 0x6E);
+            if (thisx->shape.rot.x == 0x3D00) {
+                Audio_PlayActorSound2(thisx, 0x2839);
+                this->state = 5;
+            }
+            break;
+        case 5:
+            Math_ScaledStepToS(&thisx->shape.rot.x, 0x4000, 0x5A);
+            if (thisx->shape.rot.x == 0x4000) {
+                Audio_PlayActorSound2(thisx, 0x2839);
+                this->state = 6;
+            }
+            break;
+        case 6:
+            Audio_PlayActorSound2(thisx, NA_SE_SY_CORRECT_CHIME);
+            if (this->light != NULL) {
+                Actor_Kill(this->light);
+            }
+            func_80064534(play, &play->csCtx);
+            this->finished = true;
+            break;
+    }
+}
+
