+#ifndef Z_ML_MALON_H
+#define Z_ML_MALON_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+struct MlMalon;
+
+typedef void (*MlMalonActionFunc)(struct MlMalon*, PlayState*);
+
+typedef struct MlMalon {
+    Actor actor;
+    SkelAnime skelAnime;
+    Vec3s jointTable[22];
+    Vec3s morphTable[22];
+    ColliderCylinder collider;
+    MlMalonActionFunc actionFunc;
+    Vec3s headRot;
+    Vec3s torsoRot;
+    s16 blinkTimer;
+    void* eyeTex;
+    void* mouthTex;
+    s16 state; // 0 idle; 1 accepted the race (starts it when the text closes) / race cucco spawned; 2 declined
+} MlMalon;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_Pillar/z_ml_pillar.c b/soh/src/overlays/actors/ovl_Ml_Pillar/z_ml_pillar.c
new file mode 100644
index 0000000000000000000000000000000000000000..3703a1395aaec1d8aa1c265e2373775376ff7bd6
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_Pillar/z_ml_pillar.c
@@ -0,0 +1,108 @@
+/*
+ * File: z_ml_pillar.c
+ * Overlay: ovl_Ml_Pillar
+ * Description: The Missing Link - switch-raised stone pillars in Bmori1 (ML's rewrite of En_Du, slot 0x098)
+ *
+ * Source overlay: ML dma 217, text 0x2E0, on ML's own object 0x9D (dma 30, shipped as object_ml_du). Placed three
+ * times in Bmori1 room 0. params 0 (two of them): model 0x840, waits 100 frames after switch 7, then rises 100 units
+ * at 20 a frame. params 1: model 0x720, on switch 1 holds a manual cutscene on camera setting 2, waits 60 frames, then
+ * rises 117 units at 15 a frame and ends the cutscene. A pillar whose switch is already set starts raised.
+ */
+
+#include "z_ml_pillar.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlPillar_Init(Actor* thisx, PlayState* play);
+void MlPillar_Destroy(Actor* thisx, PlayState* play);
+void MlPillar_Update(Actor* thisx, PlayState* play);
+void MlPillar_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_Pillar_InitVars = {
+    ACTOR_EN_DU,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_DU,
+    sizeof(MlPillar),
+    (ActorFunc)MlPillar_Init,
+    (ActorFunc)MlPillar_Destroy,
+    (ActorFunc)MlPillar_Update,
+    (ActorFunc)MlPillar_Draw,
+    NULL,
+};
+
+static InitChainEntry sInitChain[] = {
+    ICHAIN_F32(uncullZoneForward, 2000, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneScale, 600, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneDownward, 2000, ICHAIN_STOP),
+};
+
+void MlPillar_Init(Actor* thisx, PlayState* play) {
+    MlPillar* this = (MlPillar*)thisx;
+    CollisionHeader* colHeader = NULL;
+
+    Actor_SetScale(&this->dyna.actor, 0.1f);
+    Actor_ProcessInitChain(&this->dyna.actor, sInitChain);
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    CollisionHeader_GetVirtual(gMlPillarCol, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, &this->dyna.actor, colHeader);
+
+    if (this->dyna.actor.params == 0) {
+        this->topY = this->dyna.actor.world.pos.y + 100.0f;
+        this->switchFlag = 7;
+    } else {
+        this->topY = this->dyna.actor.world.pos.y + 117.0f;
+        this->switchFlag = 1;
+    }
+    this->switchSet = Flags_GetSwitch(play, this->switchFlag);
+    if (this->switchSet) {
+        this->dyna.actor.world.pos.y = this->topY;
+        this->raised = true;
+    }
+}
+
+void MlPillar_Destroy(Actor* thisx, PlayState* play) {
+    MlPillar* this = (MlPillar*)thisx;
+
+    DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+}
+
+void MlPillar_Update(Actor* thisx, PlayState* play) {
+    MlPillar* this = (MlPillar*)thisx;
+
+    this->switchSet = Flags_GetSwitch(play, this->switchFlag);
+    if (!this->switchSet || (this->raised == true)) {
+        return;
+    }
+
+    if (this->dyna.actor.params != 0) {
+        this->timer++;
+        Camera_ChangeDataIdx(&play->mainCamera, 2);
+        func_80064520(play, &play->csCtx);
+        if (this->timer > 60) {
+            this->dyna.actor.world.pos.y += 15.0f;
+            Audio_PlayActorSound2(&this->dyna.actor, 0x205A);
+            if (this->topY < this->dyna.actor.world.pos.y) {
+                this->dyna.actor.world.pos.y = this->topY;
+                func_80064534(play, &play->csCtx);
+                this->raised = true;
+            }
+        }
+        return;
+    }
+
+    this->timer++;
+    if (this->timer > 100) {
+        this->dyna.actor.world.pos.y += 20.0f;
+        Audio_PlayActorSound2(&this->dyna.actor, 0x205A);
+        if (this->topY < this->dyna.actor.world.pos.y) {
+            this->dyna.actor.world.pos.y = this->topY;
+            this->raised = true;
+        }
+    }
+}
+
+void MlPillar_Draw(Actor* thisx, PlayState* play) {
+    Gfx_DrawDListOpa(play, (Gfx*)((thisx->params == 0) ? gMlPillarDL : gMlPillarTallDL));
+}
