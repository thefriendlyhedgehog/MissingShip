@@ -0,0 +1,16 @@
+#ifndef Z_ML_HAKALIFT_H
+#define Z_ML_HAKALIFT_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+// ML's layout (size 0x174), for reference against its overlay; SoH's own offsets differ.
+typedef struct MlHakaLift {
+    /* 0x000 */ DynaPolyActor dyna;
+    /* 0x164 */ f32 topY;
+    /* 0x168 */ f32 bottomY;
+    /* 0x16C */ s32 state; // 0 idle, 1 rising, -1 lowering, 2 arrived (until Link steps off)
+    /* 0x170 */ s32 dir;   // direction of the next trip: 0 before the first, then 1 (up) or -1 (down)
+} MlHakaLift;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.c b/soh/src/overlays/actors/ovl_Ml_HintNuts/z_ml_hintnuts.c
