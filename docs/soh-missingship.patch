diff --git a/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.c b/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.c
new file mode 100644
index 0000000..edc8543
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.c
@@ -0,0 +1,292 @@
+/*
+ * File: z_ml_mthunder.c
+ * Overlay: ovl_Ml_MThunder
+ * Description: The Missing Link - Blade Beam and spin-charge sparkles (ML's rewrite of actor 0x57)
+ *
+ * ML replaced vanilla En_M_Thunder (the spin-attack magic) wholesale: ML dma 195, text 0x9A0, vram
+ * 0x80800000, init at +0x9E0. Its Init dispatches on params:
+ *   0xDEAD  the Blade Beam: flies 35 units/frame along its yaw for up to 20 frames, player-aligned AT
+ *           collider, drawn with vanilla's never-used gUnusedBeamBladeDL;
+ *   0xBEEF  a glow on ML's Soul-Charged Kokiri Sword while Link unsheathes it. It draws from ML's
+ *           modified object_link_child, which is not ported yet, so it is inert here;
+ *   other   what the player spawns while charging a spin: once the Soul-Charged sword is owned, a
+ *           sparkle (Eff_Dust type 3) for as long as the charge is held. Vanilla's spin glow, magic
+ *           spin and spin-attack collider are gone in ML.
+ *
+ * The beam is spawned from ML's custom code blob (dma 507, loaded at 0x80600000), ported below as
+ * MlMThunder_PlayerUpdate. Everything is gated on slingshot ammo == 40: ML repurposed the Bullet Bag
+ * (40) GetItem as the Soul-Charged Kokiri Sword, and that ammo count is its only trace in the save.
+ */
+
+#include "z_ml_mthunder.h"
+#include "objects/gameplay_keep/gameplay_keep.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlMThunder_Init(Actor* thisx, PlayState* play);
+void MlMThunder_Destroy(Actor* thisx, PlayState* play);
+void MlMThunder_UpdateCharge(Actor* thisx, PlayState* play);
+void MlMThunder_UpdateBeam(Actor* thisx, PlayState* play);
+void MlMThunder_DrawBeam(Actor* thisx, PlayState* play);
+void MlMThunder_UpdateSwitchHit(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_MThunder_InitVars = {
+    ACTOR_EN_M_THUNDER,
+    ACTORCAT_ITEMACTION,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP, // ML lists object_link_child (0x15), which only its sword-glow mode draws from
+    sizeof(MlMThunder),
+    (ActorFunc)MlMThunder_Init,
+    (ActorFunc)MlMThunder_Destroy,
+    (ActorFunc)MlMThunder_UpdateCharge,
+    NULL,
+    NULL,
+};
+
+// ML's beam collider (overlay data +0x9AC): player-aligned AT, damage flag 1 << 17, 1 damage.
+static ColliderCylinderInit sBeamCylinderInit = {
+    {
+        COLTYPE_NONE,
+        AT_ON | AT_TYPE_PLAYER,
+        AC_NONE,
+        OC1_NONE,
+        OC2_TYPE_PLAYER,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0x00020000, 0x00, 0x01 },
+        { 0x00000000, 0x00, 0x00 },
+        TOUCH_ON | TOUCH_SFX_NONE,
+        BUMP_NONE,
+        OCELEM_NONE,
+    },
+    { 32, 32, 0, { 0, 0, 0 } },
+};
+
+// The explosion ML's En_Bom clone produces (vanilla En_Bom's explosion element: explosive, 8 damage).
+static ColliderCylinderInit sSwitchHitCylinderInit = {
+    {
+        COLTYPE_HIT0,
+        AT_ON | AT_TYPE_ALL,
+        AC_NONE,
+        OC1_NONE,
+        OC2_NONE,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0x00000008, 0x00, 0x08 },
+        { 0x00000000, 0x00, 0x00 },
+        TOUCH_ON | TOUCH_SFX_NONE,
+        BUMP_NONE,
+        OCELEM_NONE,
+    },
+    { 0, 0, 0, { 0, 0, 0 } },
+};
+
+void MlMThunder_Init(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+
+    thisx->room = -1;
+
+    switch ((u16)thisx->params) {
+        case ML_MTHUNDER_BLADE_BEAM:
+            Actor_SetScale(thisx, 0.1f);
+            Collider_InitCylinder(play, &this->collider);
+            Collider_SetCylinder(play, &this->collider, thisx, &sBeamCylinderInit);
+            Collider_UpdateCylinder(thisx, &this->collider);
+            this->alpha = 255;
+            thisx->update = MlMThunder_UpdateBeam;
+            thisx->draw = MlMThunder_DrawBeam;
+            break;
+        case ML_MTHUNDER_SWITCH_HIT:
+            Collider_InitCylinder(play, &this->collider);
+            Collider_SetCylinder(play, &this->collider, thisx, &sSwitchHitCylinderInit);
+            this->timer = 10;
+            thisx->update = MlMThunder_UpdateSwitchHit;
+            break;
+        case ML_MTHUNDER_SWORD_GLOW:
+            // TODO(MissingShip): needs ML's object_link_child (sword model + glow display lists).
+            Actor_Kill(thisx);
+            break;
+        default:
+            thisx->update = MlMThunder_UpdateCharge;
+            break;
+    }
+}
+
+void MlMThunder_Destroy(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+
+    if ((u16)thisx->params == ML_MTHUNDER_BLADE_BEAM || (u16)thisx->params == ML_MTHUNDER_SWITCH_HIT) {
+        Collider_DestroyCylinder(play, &this->collider);
+    }
+}
+
+// ML +0x000: the spin-charge companion.
+void MlMThunder_UpdateCharge(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+    Player* player = GET_PLAYER(play);
+
+    if (gSaveContext.inventory.ammo[SLOT_SLINGSHOT] == 40 && !this->childSpawned) {
+        this->child = Actor_SpawnAsChild(&play->actorCtx, thisx, play, ACTOR_EFF_DUST, thisx->world.pos.x,
+                                         thisx->world.pos.y, thisx->world.pos.z, thisx->shape.rot.x,
+                                         thisx->shape.rot.y, thisx->shape.rot.z, 3);
+        this->childSpawned = true;
+    }
+
+    if (!(player->stateFlags1 & PLAYER_STATE1_CHARGING_SPIN_ATTACK)) {
+        if (this->child != NULL) {
+            Actor_Kill(this->child);
+        }
+        Actor_Kill(thisx);
+    }
+}
+
+// ML +0x544.
+void MlMThunder_UpdateBeam(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+    Player* player = GET_PLAYER(play);
+    f32 pitchScale;
+
+    if (!this->sfxPlayed) {
+        Sfx_PlaySfxCentered(NA_SE_IT_ROLLING_CUT_LV1);
+        this->sfxPlayed = true;
+    }
+
+    this->alpha -= 12;
+
+    // ML kills the beam here but, like the original, still finishes the frame.
+    if ((this->timer > 20) || (thisx->bgCheckFlags & (1 | 8)) /* ground | wall */ ||
+        (this->collider.base.atFlags & AT_HIT) || (this->collider.base.acFlags & AC_HIT)) {
+        Actor_Kill(thisx);
+    }
+    this->timer++;
+
+    Actor_UpdateBgCheckInfo(play, thisx, 0.0f, 10.0f, 0.0f, 5);
+    Collider_UpdateCylinder(thisx, &this->collider);
+    CollisionCheck_SetAT(play, &play->colChkCtx, &this->collider.base);
+    thisx->flags |= ACTOR_FLAG_SFX_FOR_PLAYER_BODY_HIT;
+
+    pitchScale = Math_CosS(thisx->world.rot.x) * -35.0f;
+    thisx->world.pos.x += pitchScale * Math_SinS(thisx->shape.rot.y);
+    thisx->world.pos.z += pitchScale * Math_CosS(thisx->shape.rot.y);
+
+    // Crystal switches: ML drops an invisible, silent explosion on any crystal switch the beam passes.
+    if (this->switchActor == NULL) {
+        this->switchActor = Actor_FindNearby(play, thisx, ACTOR_OBJ_SWITCH, ACTORCAT_SWITCH, 35.0f);
+    } else if (((this->switchActor->params & 0xF) >= 3) && !this->switchHit &&
+               (this->switchActor->world.pos.y - 10.0f < player->actor.world.pos.y)) {
+        Actor_Spawn(&play->actorCtx, play, ACTOR_EN_M_THUNDER, this->switchActor->world.pos.x,
+                    this->switchActor->world.pos.y, this->switchActor->world.pos.z, 0x3FFF, 0, 0,
+                    ML_MTHUNDER_SWITCH_HIT);
+        this->switchHit = true;
+    }
+}
+
+// ML +0x77C.
+void MlMThunder_DrawBeam(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+    u32 frames = play->gameplayFrames;
+
+    OPEN_DISPS(play->state.gfxCtx);
+
+    Gfx_SetupDL_25Xlu(play->state.gfxCtx);
+    gSPSegment(POLY_XLU_DISP++, 0x08,
+               Gfx_TwoTexScroll(play->state.gfxCtx, 0, 0, 0, 16, 64, 1, 0, frames * 5, 32, 128));
+    gSPMatrix(POLY_XLU_DISP++, MATRIX_NEWMTX(play->state.gfxCtx), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
+    gDPSetPrimColor(POLY_XLU_DISP++, 0, 0x80, 255, 255, 170, this->alpha);
+    gDPSetEnvColor(POLY_XLU_DISP++, 255, 100, 0, 128);
+    gSPDisplayList(POLY_XLU_DISP++, gUnusedBeamBladeDL);
+
+    CLOSE_DISPS(play->state.gfxCtx);
+}
+
+// Stand-in for ML's En_Bom clone: vanilla's explosion collider (radius +8 per frame for 10 frames), no
+// model, no sound, no effects -- ML nopped all of those.
+void MlMThunder_UpdateSwitchHit(Actor* thisx, PlayState* play) {
+    MlMThunder* this = (MlMThunder*)thisx;
+    s16 radius = (11 - this->timer) * 8;
+
+    this->collider.dim.radius = radius;
+    this->collider.dim.height = radius * 2;
+    this->collider.dim.yShift = -radius;
+    Collider_UpdateCylinder(thisx, &this->collider);
+    CollisionCheck_SetAT(play, &play->colChkCtx, &this->collider.base);
+
+    if (--this->timer <= 0) {
+        Actor_Kill(thisx);
+    }
+}
+
+/*
+ * Blade Beam spawner, from ML's custom code (0x80602DE0, the part that concerns the beam). ML calls it
+ * once per frame while drawing Link; SoH may draw several times per update when interpolating, so it
+ * runs from Player_Update instead. The static state mirrors ML's globals at 0x80603600-0x80603618.
+ */
+static u8 sSpinBeamState;  // 0x80603604: 0 idle, 1 charging, 2 fired / waiting for the glow to end
+static u32 sSpinChargeFrames; // 0x80603608
+static u8 sSwingBeamState; // 0x80603603: 0 idle, 1 armed, 2 fired
+static u8 sGlowActive;     // 0x80603610 (the glow colour itself belongs to the unported sword visuals)
+
+static void MlMThunder_SpawnBeam(Player* player, PlayState* play) {
+    Actor_Spawn(&play->actorCtx, play, ACTOR_EN_M_THUNDER, player->bodyPartsPos[0].x, player->bodyPartsPos[0].y,
+                player->bodyPartsPos[0].z, 0, player->actor.shape.rot.y - 0x8000, 0, ML_MTHUNDER_BLADE_BEAM);
+}
+
+// unsheathing: skelAnime.animation == gPlayerAnim_link_normal_normal2fighter_free, compared in z_player.c because
+// SoH asset symbols are per-translation-unit copies, so the pointer only matches inside the file that set it.
+void MlMThunder_PlayerUpdate(Player* player, PlayState* play, bool unsheathing) {
+    // ML takes the sword back on this entrance (its entrance 0x400, remapped by the pipeline).
+    if (gSaveContext.entranceIndex == ENTR_LON_LON_RANCH_ENTRANCE) {
+        gSaveContext.inventory.ammo[SLOT_SLINGSHOT] = 0;
+    }
+
+    if (gSaveContext.inventory.ammo[SLOT_SLINGSHOT] != 40) {
+        return;
+    }
+
+    bool charging = (player->stateFlags1 & PLAYER_STATE1_CHARGING_SPIN_ATTACK) != 0;
+    // ML reads the halfword at 0x844, so bit 0 is unk_845: odd on the first (and third) swing of a combo.
+    bool comboSwing = (player->unk_845 & 1) != 0;
+    bool fullHealth = gSaveContext.health == gSaveContext.healthCapacity;
+
+    // Spin attack: charge for at least 8 frames, release, and a beam fires.
+    if (sSpinBeamState == 0) {
+        if (charging) {
+            sSpinBeamState = 1;
+        }
+    } else if (sSpinBeamState == 1) {
+        if (charging) {
+            sSpinChargeFrames++;
+        } else {
+            if (sSpinChargeFrames >= 8) {
+                MlMThunder_SpawnBeam(player, play);
+            }
+            sSpinBeamState = 2;
+            sSpinChargeFrames = 0;
+        }
+    } else if (sSpinBeamState == 2 && !sGlowActive) {
+        sSpinBeamState = 0;
+    }
+
+    // Full health: one beam at the start of each sword combo, Kokiri Sword in hand.
+    if (comboSwing) {
+        if (fullHealth && sSwingBeamState == 0) {
+            if (player->heldItemAction == PLAYER_IA_SWORD_KOKIRI) {
+                sSwingBeamState = 1;
+            }
+        } else if (sSwingBeamState == 1) {
+            MlMThunder_SpawnBeam(player, play);
+            sSwingBeamState = 2;
+        }
+    } else if (sSwingBeamState == 1) {
+        MlMThunder_SpawnBeam(player, play);
+        sSwingBeamState = 2;
+    } else if (player->unk_844 == 0 && player->unk_845 == 0 && sSwingBeamState == 2) {
+        sSwingBeamState = 0;
+    }
+
+    sGlowActive = charging || (comboSwing && fullHealth) || unsheathing;
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.h b/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.h
new file mode 100644
index 0000000..99733be
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_MThunder/z_ml_mthunder.h
@@ -0,0 +1,30 @@
+#ifndef Z_ML_MTHUNDER_H
+#define Z_ML_MTHUNDER_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+// params values ML gives actor 0x57. Anything else is the spin-attack charge spawned by the player.
+#define ML_MTHUNDER_BLADE_BEAM 0xDEAD
+#define ML_MTHUNDER_SWORD_GLOW 0xBEEF
+// MissingShip-only: stands in for ML's gutted En_Bom clone (its actor 0x0E) that trips crystal switches.
+#define ML_MTHUNDER_SWITCH_HIT 0xB0B0
+
+struct MlMThunder;
+
+typedef struct MlMThunder {
+    Actor actor;
+    ColliderCylinder collider;
+    Actor* switchActor; // Obj_Switch within reach of the beam
+    Actor* child;       // Eff_Dust sparkle (charge mode)
+    s8 childSpawned;
+    s32 timer;
+    s8 sfxPlayed;
+    u8 alpha;
+    s8 switchHit;
+} MlMThunder;
+
+// The Blade Beam spawner ML runs every frame from its custom code (0x80602DE0); called from Player_Update.
+void MlMThunder_PlayerUpdate(Player* player, PlayState* play, bool unsheathing);
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_Malon/z_ml_malon.c b/soh/src/overlays/actors/ovl_Ml_Malon/z_ml_malon.c
new file mode 100644
index 0000000..e82eb08
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_Malon/z_ml_malon.c
@@ -0,0 +1,263 @@
+/*
+ * File: z_ml_malon.c
+ * Overlay: ovl_Ml_Malon
+ * Description: The Missing Link - young Malon and her race (ML's rewrite of En_Ma1, slot 0xE7)
+ *
+ * ML dma 236, drawn from ML's redrawn object_ma1 (object_ml_ma1). The race state is switch 0x11 of scene 0x5A
+ * (the Gerudo Valley slot), read from the save at Init. ML entrance numbers go through MlEntrance_ToSoh.
+ *   params 0xFFFF  the finish line: reach her (within 80, not below her) while the timer runs and the race ends --
+ *                  switch 0x11, timer stopped, warp to ML entrance 0x13C.
+ *   otherwise      the host. Offers text 0x204A (0x204F once the race is won, when she also releases a cucco at
+ *                  (-778,-485,308), ML's recoloured one in slot 0x0D, params 4). Choosing the first option of
+ *                  0x204A answers 0x204C and warps to ML entrance 0x138, the race; the other answers 0x204B.
+ *                  Arriving by ML entrance 0x13C (the finish) she speaks first: 0x2050 on a loss, 0x204D on a
+ *                  win, whose 0x204E line releases the cucco.
+ */
+
+#include "z_ml_malon.h"
+#include "assets/ml_assets.h"
+#include "code/ml_entrance_map.h"
+
+#define FLAGS (ACTOR_FLAG_ATTENTION_ENABLED | ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+#define ML_MALON_RACE_SCENE 0x5A
+#define ML_MALON_WON_SWITCH 0x11
+
+void MlMalon_Init(Actor* thisx, PlayState* play);
+void MlMalon_Destroy(Actor* thisx, PlayState* play);
+void MlMalon_Update(Actor* thisx, PlayState* play);
+void MlMalon_Draw(Actor* thisx, PlayState* play);
+
+void MlMalon_Host(MlMalon* this, PlayState* play);
+void MlMalon_HostWon(MlMalon* this, PlayState* play);
+void MlMalon_GreetLoss(MlMalon* this, PlayState* play);
+void MlMalon_GreetWin(MlMalon* this, PlayState* play);
+void MlMalon_FinishLine(MlMalon* this, PlayState* play);
+
+const ActorInit Ml_Malon_InitVars = {
+    ACTOR_EN_MA1,
+    ACTORCAT_NPC,
+    FLAGS,
+    OBJECT_MA1,
+    sizeof(MlMalon),
+    (ActorFunc)MlMalon_Init,
+    (ActorFunc)MlMalon_Destroy,
+    (ActorFunc)MlMalon_Update,
+    (ActorFunc)MlMalon_Draw,
+    NULL,
+};
+
+static ColliderCylinderInit sCylinderInit = {
+    {
+        COLTYPE_NONE,
+        AT_ON | AT_TYPE_ENEMY,
+        AC_ON | AC_TYPE_PLAYER,
+        OC1_ON | OC1_TYPE_ALL,
+        OC2_TYPE_2,
+        COLSHAPE_CYLINDER,
+    },
+    {
+        ELEMTYPE_UNK0,
+        { 0x00000000, 0x00, 0x00 },
+        { 0xFFCFFFFF, 0x00, 0x00 },
+        TOUCH_NONE,
+        BUMP_ON,
+        OCELEM_ON,
+    },
+    { 23, 35, 0, { 0, 0, 0 } },
+};
+
+static void* sEyeTextures[] = { gMlMalonEyeOpenTex, gMlMalonEyeHalfTex, gMlMalonEyeClosedTex };
+
+static void MlMalon_SetAnim(MlMalon* this, void* anim) {
+    if (this->skelAnime.animation != anim) {
+        Animation_MorphToLoop(&this->skelAnime, anim, -5.0f);
+    }
+}
+
+static void MlMalon_SpawnCucco(PlayState* play) {
+    Actor_Spawn(&play->actorCtx, play, ACTOR_EN_POH, -778.0f, -485.0f, 308.0f, 0, 0x1680, 0, 4);
+}
+
+static void MlMalon_SetupHost(MlMalon* this) {
+    this->actor.flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+    this->mouthTex = gMlMalonMouthNeutralTex;
+    this->actor.textId = 0x204A;
+    this->state = 0;
+    this->actionFunc = MlMalon_Host;
+}
+
+static void MlMalon_SetupHostWon(MlMalon* this) {
+    this->actor.flags &= ~ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+    this->mouthTex = gMlMalonMouthNeutralTex;
+    this->actor.textId = 0x204F;
+    this->state = 0;
+    this->actionFunc = MlMalon_HostWon;
+}
+
+void MlMalon_Init(Actor* thisx, PlayState* play) {
+    MlMalon* this = (MlMalon*)thisx;
+    s32 won = (gSaveContext.sceneFlags[ML_MALON_RACE_SCENE].swch >> ML_MALON_WON_SWITCH) & 1;
+
+    Collider_InitCylinder(play, &this->collider);
+    Collider_SetCylinder(play, &this->collider, thisx, &sCylinderInit);
+    SkelAnime_InitFlex(play, &this->skelAnime, (void*)gMlMalonSkel, (void*)gMlMalonIdleAnim, NULL, NULL, 0);
+    Animation_PlayLoop(&this->skelAnime, (void*)gMlMalonIdleAnim);
+    MlMalon_SetAnim(this, (void*)gMlMalonIdleAnim);
+    Actor_SetScale(thisx, 0.01f);
+    ActorShape_Init(&thisx->shape, 0.0f, ActorShadow_DrawCircle, 20.0f);
+    this->eyeTex = gMlMalonEyeOpenTex;
+
+    if (gSaveContext.entranceIndex == MlEntrance_ToSoh(0x13C)) {
+        // Back from the race: she speaks first.
+        gSaveContext.entranceIndex = MlEntrance_ToSoh(0x58);
+        MlMalon_SetAnim(this, (void*)gMlMalonTalkAnim);
+        thisx->flags |= ACTOR_FLAG_TALK_OFFER_AUTO_ACCEPTED;
+        if (won) {
+            this->mouthTex = gMlMalonMouthHappyTex;
+            thisx->textId = 0x204D;
+            this->actionFunc = MlMalon_GreetWin;
+        } else {
+            this->mouthTex = gMlMalonMouthSadTex;
+            thisx->textId = 0x2050;
+            this->actionFunc = MlMalon_GreetLoss;
+        }
+    } else if ((u16)thisx->params == 0xFFFF) {
+        MlMalon_SetAnim(this, (void*)gMlMalonTalkAnim);
+        this->mouthTex = gMlMalonMouthHappyTex;
+        this->actionFunc = MlMalon_FinishLine;
+    } else if (won) {
+        MlMalon_SpawnCucco(play);
+        MlMalon_SetupHostWon(this);
+    } else {
+        MlMalon_SetupHost(this);
+    }
+}
+
+void MlMalon_Destroy(Actor* thisx, PlayState* play) {
+    MlMalon* this = (MlMalon*)thisx;
+
+    Collider_DestroyCylinder(play, &this->collider);
+}
+
+static s32 MlMalon_OfferTalk(MlMalon* this, PlayState* play) {
+    if (this->actor.xzDistToPlayer < 120.0f && ABS((s16)(this->actor.yawTowardsPlayer - this->actor.shape.rot.y)) < 0x4300) {
+        func_8002F2F4(&this->actor, play);
+        MlMalon_SetAnim(this, Message_GetState(&play->msgCtx) != TEXT_STATE_NONE ? (void*)gMlMalonTalkAnim
+                                                                                 : (void*)gMlMalonIdleAnim);
+        return true;
+    }
+    return false;
+}
+
+void MlMalon_Host(MlMalon* this, PlayState* play) {
+    MlMalon_OfferTalk(this, play);
+
+    if (Message_GetState(&play->msgCtx) == TEXT_STATE_CHOICE && Message_ShouldAdvance(play)) {
+        if (play->msgCtx.choiceIndex == 0) {
+            this->mouthTex = gMlMalonMouthHappyTex;
+            Message_ContinueTextbox(play, 0x204C);
+            this->state = 1;
+        } else {
+            this->mouthTex = gMlMalonMouthSadTex;
+            Message_ContinueTextbox(play, 0x204B);
+            this->state = 2;
+        }
+    } else if (Message_GetState(&play->msgCtx) == TEXT_STATE_NONE) {
+        if (this->state == 1) {
+            func_80064520(play, &play->csCtx);
+            play->nextEntranceIndex = MlEntrance_ToSoh(0x138);
+            play->transitionTrigger = TRANS_TRIGGER_START;
+        } else {
+            this->mouthTex = gMlMalonMouthNeutralTex;
+            this->state = 0;
+        }
+    }
+}
+
+void MlMalon_HostWon(MlMalon* this, PlayState* play) {
+    MlMalon_OfferTalk(this, play);
+}
+
+void MlMalon_GreetLoss(MlMalon* this, PlayState* play) {
+    if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) {
+        MlMalon_SetupHost(this);
+    }
+    func_8002F2CC(&this->actor, play, 1000.0f);
+}
+
+void MlMalon_GreetWin(MlMalon* this, PlayState* play) {
+    if (Message_GetState(&play->msgCtx) == TEXT_STATE_DONE) {
+        MlMalon_SetupHostWon(this);
+        return;
+    }
+    func_8002F2CC(&this->actor, play, 1000.0f);
+    if (play->msgCtx.textId == 0x204E && this->state == 0) {
+        MlMalon_SpawnCucco(play);
+        this->state = 1;
+    }
+}
+
+void MlMalon_FinishLine(MlMalon* this, PlayState* play) {
+    Player* player = GET_PLAYER(play);
+
+    if ((this->actor.world.pos.y - 20.0f) < player->actor.world.pos.y && this->actor.xzDistToPlayer < 80.0f &&
+        gSaveContext.timerSeconds > 0) {
+        func_80064520(play, &play->csCtx);
+        Flags_SetSwitch(play, ML_MALON_WON_SWITCH);
+        gSaveContext.timerState = 10;
+        play->nextEntranceIndex = MlEntrance_ToSoh(0x13C);
+        play->transitionTrigger = TRANS_TRIGGER_START;
+    }
+}
+
+void MlMalon_Update(Actor* thisx, PlayState* play) {
+    MlMalon* this = (MlMalon*)thisx;
+
+    this->actionFunc(this, play);
+    Actor_UpdateBgCheckInfo(play, thisx, 20.0f, this->collider.dim.radius, this->collider.dim.height,
+                            5);
+    Collider_UpdateCylinder(thisx, &this->collider);
+    CollisionCheck_SetOC(play, &play->colChkCtx, &this->collider.base);
+    SkelAnime_Update(&this->skelAnime);
+
+    if (this->blinkTimer == 0) {
+        this->blinkTimer = Rand_S16Offset(30, 30);
+    }
+    this->blinkTimer--;
+    this->eyeTex = (this->blinkTimer < 2) ? sEyeTextures[(u8)(2 - this->blinkTimer)] : gMlMalonEyeOpenTex;
+}
+
+static s32 MlMalon_OverrideLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3f* pos, Vec3s* rot, void* thisx) {
+    MlMalon* this = (MlMalon*)thisx;
+
+    if (limbIndex == 14) {
+        func_80038290(play, &this->actor, &this->headRot, &this->torsoRot, this->actor.world.pos);
+        rot->x += this->torsoRot.y;
+    }
+    return false;
+}
+
+static void MlMalon_PostLimbDraw(PlayState* play, s32 limbIndex, Gfx** dList, Vec3s* rot, void* thisx) {
+    static Vec3f zeroVec = { 0.0f, 0.0f, 0.0f };
+    MlMalon* this = (MlMalon*)thisx;
+
+    if (limbIndex == 14) {
+        Matrix_MultVec3f(&zeroVec, &this->actor.focus.pos);
+    }
+}
+
+void MlMalon_Draw(Actor* thisx, PlayState* play) {
+    MlMalon* this = (MlMalon*)thisx;
+
+    OPEN_DISPS(play->state.gfxCtx);
+
+    Gfx_SetupDL_25Opa(play->state.gfxCtx);
+    gSPSegment(POLY_OPA_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(this->eyeTex));
+    gSPSegment(POLY_XLU_DISP++, 0x08, SEGMENTED_TO_VIRTUAL(this->eyeTex));
+    gSPSegment(POLY_OPA_DISP++, 0x09, SEGMENTED_TO_VIRTUAL(this->mouthTex));
+    gSPSegment(POLY_XLU_DISP++, 0x09, SEGMENTED_TO_VIRTUAL(this->mouthTex));
+    SkelAnime_DrawSkeletonOpa(play, &this->skelAnime, MlMalon_OverrideLimbDraw, MlMalon_PostLimbDraw, this);
+
+    CLOSE_DISPS(play->state.gfxCtx);
