+/*
+ * File: z_ml_prologue.c
+ * Overlay: ovl_Ml_Prologue
+ * Description: The Missing Link - the illustrated prologue ("But one day...") (ML actor 0x01F)
+ *
+ * Ported from ML's overlay in vanilla's unused slot 0x01F (ML dma 169). Placed once in ML's intro stub scene
+ * (link_home slot). It shows five 320x192 CI4 illustrations from ML-only object 0x04 (object_ml_prologue), switching
+ * at frames 445, 695, 945 and 1195 while the prologue cutscene's text plays, drawn screen-space as 24 strips of
+ * 320x8 from line 24 to 216 -- as ML does, each strip fits TMEM.
+ */
+
+#include "z_ml_prologue.h"
+#include "assets/ml_assets.h"
+
+#define FLAGS (ACTOR_FLAG_UPDATE_CULLING_DISABLED | ACTOR_FLAG_DRAW_CULLING_DISABLED)
+
+void MlPrologue_Init(Actor* thisx, PlayState* play);
+void MlPrologue_Destroy(Actor* thisx, PlayState* play);
+void MlPrologue_Update(Actor* thisx, PlayState* play);
+void MlPrologue_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_Prologue_InitVars = {
+    ACTOR_ML_PROLOGUE,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_GAMEPLAY_KEEP, // ML lists its object 0x04; the pictures are loaded by path here
+    sizeof(MlPrologue),
+    (ActorFunc)MlPrologue_Init,
+    (ActorFunc)MlPrologue_Destroy,
+    (ActorFunc)MlPrologue_Update,
+    (ActorFunc)MlPrologue_Draw,
+    NULL,
+};
+
+static const ALIGN_ASSET(2) char sTlut0[] = "__OTR__objects/object_ml_prologue/gMlPrologue0TLUT";
+static const ALIGN_ASSET(2) char sStrip0_00[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip00Tex";
+static const ALIGN_ASSET(2) char sStrip0_01[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip01Tex";
+static const ALIGN_ASSET(2) char sStrip0_02[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip02Tex";
+static const ALIGN_ASSET(2) char sStrip0_03[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip03Tex";
+static const ALIGN_ASSET(2) char sStrip0_04[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip04Tex";
+static const ALIGN_ASSET(2) char sStrip0_05[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip05Tex";
+static const ALIGN_ASSET(2) char sStrip0_06[] = "__OTR__objects/object_ml_prologue/gMlPrologue0Strip06Tex";
