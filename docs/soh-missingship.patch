+#ifndef Z_ML_PILLAR_H
+#define Z_ML_PILLAR_H
+
+#include <libultraship/libultra.h>
+#include "global.h"
+
+// ML's layout (size 0x178), for reference against its overlay; SoH's own offsets differ.
+typedef struct MlPillar {
+    /* 0x000 */ DynaPolyActor dyna;
+    /* 0x164 */ s32 switchFlag;
+    /* 0x168 */ s32 switchSet;
+    /* 0x16C */ s32 raised;
+    /* 0x170 */ s32 timer;
+    /* 0x174 */ f32 topY;
+} MlPillar;
+
+#endif
diff --git a/soh/src/overlays/actors/ovl_Ml_Prologue/z_ml_prologue.c b/soh/src/overlays/actors/ovl_Ml_Prologue/z_ml_prologue.c
