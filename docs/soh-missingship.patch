+    { 0x703A, 1 },  // OK / I don't believe you
+};
+
+// The option B selects on the current choice prompt, or -1 when B does nothing there.
+static s32 MlChoice_BIndex(MessageContext* msgCtx) {
+    for (u32 i = 0; i < ARRAY_COUNT(sMlChoiceBException); i++) {
+        if (sMlChoiceBException[i].textId == msgCtx->textId) {
+            return sMlChoiceBException[i].bChoice;
+        }
+    }
+    return (msgCtx->textboxEndType == TEXTBOX_ENDTYPE_3_CHOICE) ? 2 : 1;
+}
+
+// On a choice prompt, returns whether this frame's input answers it: A or C-Up confirm the highlighted option as
+// usual; a B press selects the option from MlChoice_BIndex. Returns -1 when not on a choice prompt (vanilla rules).
+static s32 MlChoice_ShouldAdvance(PlayState* play) {
+    MessageContext* msgCtx = &play->msgCtx;
+    Input* input = &play->state.input[0];
+
+    if (!CVarGetInteger(CVAR_ENHANCEMENT("MissingShip.BCancelsChoice"), 1) ||
+        Message_GetState(msgCtx) != TEXT_STATE_CHOICE) {
+        return -1;
+    }
+    if (CHECK_BTN_ALL(input->press.button, BTN_A) || CHECK_BTN_ALL(input->press.button, BTN_CUP)) {
+        return true;
+    }
+    if (CHECK_BTN_ALL(input->press.button, BTN_B)) {
+        s32 index = MlChoice_BIndex(msgCtx);
+        if (index >= 0) {
+            msgCtx->choiceIndex = index;
+            return true;
+        }
+    }
+    return false;
+}
