diff --git a/soh/src/overlays/actors/ovl_Ml_Elevator/z_ml_elevator.c b/soh/src/overlays/actors/ovl_Ml_Elevator/z_ml_elevator.c
new file mode 100644
index 0000000000000000000000000000000000000000..9ec0a9bd56b29963b9970d2dee1e897b3402807b
--- /dev/null
+++ b/soh/src/overlays/actors/ovl_Ml_Elevator/z_ml_elevator.c
@@ -0,0 +1,135 @@
+/*
+ * File: z_ml_elevator.c
+ * Overlay: ovl_Ml_Elevator
+ * Description: The Missing Link - HAKAdan's elevators (ML's rewrite of En_Kakasi, slot 0x17B)
+ *
+ * Source overlay: ML dma 290, text 0x390, on ML's own object 0x154 (dma 380). params 0: rises 309 units at 10 per
+ * frame (placed twice in room 16). params 1: rises 1784 units at 45 per frame (spawned by Ml_ElevatorSpawner).
+ * Standing on it sends it to the other end, where it waits until Link steps off. It comes back down when Link is
+ * below its top, and the tall one also drops while a Magic Hourglass rewind plays with Link within 100 units.
+ * While the tall one carries Link, the camera switches to setting 9.
+ * ML's Update is branchy compiler output; the flow below follows it label by label.
+ */
+
+#include "z_ml_elevator.h"
+#include "assets/ml_assets.h"
+#include "src/code/ml_state.h"
+
+#define FLAGS ACTOR_FLAG_UPDATE_CULLING_DISABLED
+
+void MlElevator_Init(Actor* thisx, PlayState* play);
+void MlElevator_Destroy(Actor* thisx, PlayState* play);
+void MlElevator_Update(Actor* thisx, PlayState* play);
+void MlElevator_Draw(Actor* thisx, PlayState* play);
+
+const ActorInit Ml_Elevator_InitVars = {
+    ACTOR_EN_KAKASI,
+    ACTORCAT_BG,
+    FLAGS,
+    OBJECT_KA,
+    sizeof(MlElevator),
+    (ActorFunc)MlElevator_Init,
+    (ActorFunc)MlElevator_Destroy,
+    (ActorFunc)MlElevator_Update,
+    (ActorFunc)MlElevator_Draw,
+    NULL,
+};
+
+static InitChainEntry sInitChain[] = {
+    ICHAIN_VEC3F_DIV1000(scale, 1000, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneForward, 3000, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneScale, 500, ICHAIN_CONTINUE),
+    ICHAIN_F32(uncullZoneDownward, 1000, ICHAIN_STOP),
+};
+
+void MlElevator_Init(Actor* thisx, PlayState* play) {
+    MlElevator* this = (MlElevator*)thisx;
+    CollisionHeader* colHeader = NULL;
+
+    Actor_ProcessInitChain(thisx, sInitChain);
+    DynaPolyActor_Init(&this->dyna, DPM_PLAYER);
+    CollisionHeader_GetVirtual(gMlElevatorCol, &colHeader);
+    this->dyna.bgId = DynaPoly_SetBgActor(play, &play->colCtx.dyna, thisx, colHeader);
+    this->state = 0;
+    this->dir = 0;
+    this->bottomY = thisx->world.pos.y;
+    this->topY = thisx->world.pos.y + ((thisx->params != 0) ? 1784.0f : 309.0f);
+}
+
+void MlElevator_Destroy(Actor* thisx, PlayState* play) {
+    MlElevator* this = (MlElevator*)thisx;
+
+    DynaPoly_DeleteBgActor(play, &play->colCtx.dyna, this->dyna.bgId);
+}
+
+void MlElevator_Update(Actor* thisx, PlayState* play) {
+    MlElevator* this = (MlElevator*)thisx;
+    Player* player = GET_PLAYER(play);
+    s32 onTop = DynaPolyActor_IsPlayerOnTop(&this->dyna);
+    f32 speed = (thisx->params != 0) ? 45.0f : 10.0f;
+    f32* y = &thisx->world.pos.y;
+
+    if (onTop || ((this->bottomY < *y) && (player->actor.world.pos.y < this->topY - 50.0f))) {
+        if (this->state == 0) {
+            this->state = (this->dir == 0) ? 1 : this->dir;
+        }
+        if (this->state == 1) {
+            goto rising;
+        }
+        goto lowering;
+    }
+    if (this->state == 2) {
+        this->state = 0;
+        goto recall;
+    }
+    if (this->state == 1) {
+        goto recall;
+    }
+
+lowering:
+    if (this->state != -1) {
+        goto recall;
+    }
+lower:
+    Audio_PlayActorSound2(thisx, NA_SE_EV_BUYOSTAND_FALL - SFX_FLAG);
+    *y -= speed;
+    if (*y <= this->bottomY) {
+        this->dir = 1;
+        *y = this->bottomY;
+        this->state = 2;
+        return;
+    }
+    goto tail;
+
+rising:
+    if (!onTop) {
+        goto recall;
+    }
+    *y += speed;
+    Audio_PlayActorSound2(thisx, NA_SE_EV_BUYOSTAND_RISING - SFX_FLAG);
+    if (this->topY <= *y) {
+        this->dir = -1;
+        *y = this->topY;
+        this->state = 2;
+        return;
+    }
+    goto tail;
+
+recall:
+    // Called back down: Link is below its top, or (tall one) an Hourglass rewind plays nearby
+    if ((this->bottomY < *y) && (player->actor.world.pos.y < this->topY - 50.0f)) {
+        goto lower;
+    }
+    if ((gMlRewindStep != 0) && (thisx->params != 0) && (this->bottomY < *y) && (thisx->xzDistToPlayer < 100.0f)) {
+        goto lower;
+    }
+
+tail:
+    if (((this->state == 1) || (this->state == -1)) && onTop && (thisx->params == 1)) {
+        Camera_ChangeDataIdx(&play->mainCamera, 9);
+    }
+}
+
+void MlElevator_Draw(Actor* thisx, PlayState* play) {
+    Gfx_DrawDListOpa(play, (Gfx*)((thisx->params != 0) ? gMlElevatorTallDL : gMlElevatorDL));
+}
diff --git a/soh/src/overlays/actors/ovl_Ml_Elevator/z_ml_elevator.h b/soh/src/overlays/actors/ovl_Ml_Elevator/z_ml_elevator.h
