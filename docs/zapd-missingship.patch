+// A sample's loop and codebook as far as they lie inside the audio bank; past its end they read as zero. The Missing
+// Link has a sample (bank 0, its header at 0x12C0) whose loop and book pointers are 0, so its "book" is the font's own
+// header (order 384, 400 predictors): 1.2M entries, read megabytes past the bank, which crashed the Windows extractor
+// and put whatever memory followed into the archive elsewhere. Its data starts at the audio table's end (see below).
+static int16_t BankInt16(const std::vector<uint8_t>& bank, int32_t offset)
+{
+	return (offset >= 0 && (size_t)offset + 2 <= bank.size()) ? BitConverter::ToInt16BE(bank, offset) : 0;
+}
+
+static int32_t BankInt32(const std::vector<uint8_t>& bank, int32_t offset)
+{
+	return (offset >= 0 && (size_t)offset + 4 <= bank.size()) ? BitConverter::ToInt32BE(bank, offset) : 0;
