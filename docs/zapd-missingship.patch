diff --git a/ZAPD/ZAudio.cpp b/ZAPD/ZAudio.cpp
index 03c1efa99341ba516d3a44c5c4d533c08e49474e..d860b9f2c6642a96f6f23bd5928717c88ff57173 100644
--- a/ZAPD/ZAudio.cpp
+++ b/ZAPD/ZAudio.cpp
@@ -1,5 +1,7 @@
 #include "ZAudio.h"
 
+#include <algorithm>
+
 #include "Globals.h"
 #include "Utils/BitConverter.h"
 #include <Utils/DiskFile.h>
@@ -132,8 +134,16 @@ SampleEntry* ZAudio::ParseSampleEntry(const std::vector<uint8_t>& audioBank,
 		sample->bankId = bankIndex;
 
 
+		// Copy only what lies inside the audio table; the rest stays zero. The Missing Link points a sound effect
+		// (font 1, sfx 1) at a sample that starts exactly at the table's end, and reading past the buffer put
+		// whatever memory followed into the archive, so it differed between platforms.
 		sample->data = std::vector<uint8_t>(sampleSize);
-		memcpy(sample->data.data(), audioTable.data() + sampleDataOffset, sampleSize);
+		size_t sampleStart = (uint32_t)sampleDataOffset;
+		size_t sampleAvail = sampleStart < audioTable.size() ?
+		                         std::min<size_t>(sampleSize, audioTable.size() - sampleStart) :
+		                         0;
+		if (sampleAvail > 0)
+			memcpy(sample->data.data(), audioTable.data() + sampleStart, sampleAvail);
 
 		uint32_t origField = (BitConverter::ToUInt32BE(audioBank, sampleOffset + 0));
 		sample->codec = (origField >> 28) & 0x0F;
@@ -381,6 +391,17 @@ void ZAudio::ParseRawData()
 	// SAMPLE/FONT PARSING
 	for (auto& sft : soundFontTable)
 	{
+		// A soundfont table entry with no data is an unused slot. The sequence loop below already
+		// skips these (size == 0), but the soundfont loop did not: it would still walk the entry's
+		// instrument/drum/sfx counts and dereference offsets relative to ptr == 0, reading far past
+		// the end of the audiobank. Real ROM hacks hit this -- The Missing Link zeroes out the
+		// soundfonts it does not use while leaving their counts intact, and 22 of its 38 entries
+		// crash the extractor without this guard.
+		if (sft.size == 0)
+		{
+			continue;
+		}
+
 		ParseSoundFont(audioBankData, audioTableData, sampleBankTable, sft);
 	}
 
