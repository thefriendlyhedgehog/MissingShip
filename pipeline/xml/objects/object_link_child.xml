<Root>
    <!-- ML's object_link_child (object 0x15, dma 6): ML redrew child Link inside the vanilla file and appended more
         data, so every symbol moved. Shipped under the vanilla path and names so the engine draws ML's Link with its own
         code. Offsets come from ML's own references at the same places in `code` (z_player_lib's tables, 0x108D14-
         0x1092E4, plus the bracelet and Deku Stick lui/addiu pairs), the player overlay (the masks) and Item_Shield.
         ML's model has one LOD, so each vanilla Near/Far pair is one DL: the Near name is declared here and
         inject_obj_patches.py ships the Far name as a copy (LC_ALIASES there). Limb-only DLs keep ZAPD's names on
         purpose: SoH's cosmetics editor patches the vanilla limb DLs at vanilla command indices (MS-050). -->
    <File Name="object_link_child" Segment="6">
        <!-- Eyes (segment 8) and mouth (segment 9): vanilla's offsets, ML's palettes. -->
        <Texture Name="gLinkChildEyesOpenTex" OutName="eyes_open" Format="ci8" Width="64" Height="32" Offset="0x0" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesHalfTex" OutName="eyes_half" Format="ci8" Width="64" Height="32" Offset="0x800" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesClosedfTex" OutName="eyes_closed" Format="ci8" Width="64" Height="32" Offset="0x1000" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesRollLeftTex" OutName="eyes_roll_left" Format="ci8" Width="64" Height="32" Offset="0x1800" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesRollRightTex" OutName="eyes_roll_right" Format="ci8" Width="64" Height="32" Offset="0x2000" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesShockTex" OutName="eyes_shock" Format="ci8" Width="64" Height="32" Offset="0x2800" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesUnk1Tex" OutName="eyes_unk1" Format="ci8" Width="64" Height="32" Offset="0x3000" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildEyesUnk2Tex" OutName="eyes_unk2" Format="ci8" Width="64" Height="32" Offset="0x3800" TlutOffset="0x6BF0"/>
        <Texture Name="gLinkChildMouth1Tex" OutName="mouth_1" Format="ci8" Width="32" Height="32" Offset="0x4000" TlutOffset="0x7A30"/>
        <Texture Name="gLinkChildMouth2Tex" OutName="mouth_2" Format="ci8" Width="32" Height="32" Offset="0x4400" TlutOffset="0x7A30"/>
        <Texture Name="gLinkChildMouth3Tex" OutName="mouth_3" Format="ci8" Width="32" Height="32" Offset="0x4800" TlutOffset="0x7A30"/>
        <Texture Name="gLinkChildMouth4Tex" OutName="mouth_4" Format="ci8" Width="32" Height="32" Offset="0x4C00" TlutOffset="0x7A30"/>

        <!-- The Bunny Hood's first texture reuses a tile set up earlier, so ZAPD can't size it on its own. -->
        <Texture Name="gMlChildBunnyHoodTex" OutName="bunny_hood" Format="rgba16" Width="16" Height="16" Offset="0x13B50"/>

        <Skeleton Name="gLinkChildSkel" Type="Flex" LimbType="LOD" Offset="0x23204"/>

